digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"R" [label=<<TABLE BORDER="1" WIDTH="192" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="192" BGCOLOR="#eee9fb"><B>Abstraction: Report</B></TD></TR><TR><TD WIDTH="192" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">const Writer&amp; writer_;</FONT></TD></TR></TABLE>>];
"C" [label=<<TABLE BORDER="1" WIDTH="259" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="259" BGCOLOR="#eee9fb"><B>Refined: CountReport</B></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return writer_.field(&quot;count&quot;, n);</FONT></TD></TR></TABLE>>];
"W" [label=<<TABLE BORDER="1" WIDTH="224" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="224" BGCOLOR="#eee9fb"><B>Implementor: Writer</B></TD></TR><TR><TD WIDTH="224" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">virtual ~Writer() = default;</FONT></TD></TR></TABLE>>];
"B" [label=<<TABLE BORDER="1" WIDTH="343" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="343" BGCOLOR="#eee9fb"><B>Concrete: Brackets</B></TD></TR><TR><TD WIDTH="343" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return &quot;[&quot; + name + &quot;:&quot; + std::to_string(n) +<BR ALIGN="LEFT"/>&quot;]&quot;;<BR ALIGN="LEFT"/>// Formats a supplied field.</FONT></TD></TR></TABLE>>];
"C" -> "R" [arrowhead=empty,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="89" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="89">is a report</TD></TR></TABLE>>];
"R" -> "W" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="164" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="164">borrows implementation</TD></TR></TABLE>>];
"B" -> "W" [arrowhead=empty,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="89" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="89">is a writer</TD></TR></TABLE>>];
}