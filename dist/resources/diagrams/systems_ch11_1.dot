digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"input" [label=<<TABLE BORDER="1" WIDTH="308" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="308" BGCOLOR="#eee9fb"><B>Establish the starting state</B></TD></TR><TR><TD WIDTH="308" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Inputs or state for this execution.<BR ALIGN="LEFT"/>const std::vector&lt;int&gt; values{8, 9, 10};</FONT></TD></TR></TABLE>>];
"mechanism" [label=<<TABLE BORDER="1" WIDTH="287" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="287" BGCOLOR="#eee9fb"><B>Turn an off-by-one read into a<BR/>checked failure</B></TD></TR><TR><TD WIDTH="287" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Focus: follow the operation below.<BR ALIGN="LEFT"/>try {<BR ALIGN="LEFT"/>std::cout &lt;&lt; values.at(3) &lt;&lt; '\n';<BR ALIGN="LEFT"/>} catch (const std::out_of_range&amp;) {<BR ALIGN="LEFT"/>std::cout &lt;&lt; &quot;out of range\n&quot;;<BR ALIGN="LEFT"/>}</FONT></TD></TR></TABLE>>];
"observe" [label=<<TABLE BORDER="1" WIDTH="343" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="343" BGCOLOR="#eee9fb"><B>Observe the promised result</B></TD></TR><TR><TD WIDTH="343" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Check the result; retain the exact output.<BR ALIGN="LEFT"/>assert(values.size() == 3);</FONT></TD></TR></TABLE>>];
"input" -> "mechanism" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">Execute the selected<BR/>operation</TD></TR></TABLE>>];
"mechanism" -> "observe" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="130" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="130">Observe after the<BR/>operation</TD></TR></TABLE>>];
}