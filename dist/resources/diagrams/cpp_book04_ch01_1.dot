digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"call" [label=<<TABLE BORDER="1" WIDTH="308" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="308" BGCOLOR="#eee9fb"><B>Caller supplies a value</B></TD></TR><TR><TD WIDTH="308" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">transform(7)<BR ALIGN="LEFT"/>// The integer is converted to uint64_t.</FONT></TD></TR></TABLE>>];
"body" [label=<<TABLE BORDER="1" WIDTH="322" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="322" BGCOLOR="#eee9fb"><B>Compute in the function</B></TD></TR><TR><TD WIDTH="322" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return (x + 5) * 4;<BR ALIGN="LEFT"/>// Parentheses make addition happen first.</FONT></TD></TR></TABLE>>];
"output" [label=<<TABLE BORDER="1" WIDTH="266" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="266" BGCOLOR="#eee9fb"><B>Observe the result</B></TD></TR><TR><TD WIDTH="266" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::cout &lt;&lt; transform(7) &lt;&lt; &quot;\n&quot;;<BR ALIGN="LEFT"/>// The expression yields 48.</FONT></TD></TR></TABLE>>];
"call" -> "body" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="96" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="96">x receives 7</TD></TR></TABLE>>];
"body" -> "output" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">return the value 48</TD></TR></TABLE>>];
}