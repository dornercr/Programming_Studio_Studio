digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"type" [label=<<TABLE BORDER="1" WIDTH="308" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="308" BGCOLOR="#eee9fb"><B>UserId</B></TD></TR><TR><TD WIDTH="308" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">struct UserId{ int value; };<BR ALIGN="LEFT"/>// A wrapper type with one public field.</FONT></TD></TR></TABLE>>];
"equal" [label=<<TABLE BORDER="1" WIDTH="287" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="287" BGCOLOR="#eee9fb"><B>Equality operation</B></TD></TR><TR><TD WIDTH="287" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">bool operator==(UserId a, UserId b){<BR ALIGN="LEFT"/>    return a.value==b.value;<BR ALIGN="LEFT"/>}<BR ALIGN="LEFT"/>// Parameters are small value copies.</FONT></TD></TR></TABLE>>];
"caller" [label=<<TABLE BORDER="1" WIDTH="350" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="350" BGCOLOR="#eee9fb"><B>Caller</B></TD></TR><TR><TD WIDTH="350" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">UserId a{7}, b{7};<BR ALIGN="LEFT"/>std::cout &lt;&lt; std::boolalpha &lt;&lt; (a==b) &lt;&lt; '\n';<BR ALIGN="LEFT"/>// The stream prints true, then a newline.</FONT></TD></TR></TABLE>>];
"caller" -> "type" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">constructs two UserId<BR/>values</TD></TR></TABLE>>];
"caller" -> "equal" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="116" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="116">uses overloaded<BR/>equality</TD></TR></TABLE>>];
"equal" -> "type" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="110" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="110">accepts UserId<BR/>parameters</TD></TR></TABLE>>];
}