digraph G { graph [rankdir=TB, bgcolor="#fcfbff", pad="0.3", nodesep="0.4", ranksep="0.7"]; node [shape=plain]; edge [fontname="Arial", fontsize=13, color="#7955ac", penwidth=1.8];
"owner" [label=<<TABLE WIDTH="438" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>Owner construction</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">if (fail) throw std::runtime_error(&quot;construction&quot;);<BR ALIGN="LEFT"/>// Failure path: owner never completes.</FONT></TD></TR></TABLE>>];
"members" [label=<<TABLE WIDTH="330" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>Completed members A and B</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">LoggedMember a, b;<BR ALIGN="LEFT"/>// Destruction runs B, then A.</FONT></TD></TR></TABLE>>];
"log" [label=<<TABLE WIDTH="330" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>Caller-owned log</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">std::vector&lt;std::string&gt; log;<BR ALIGN="LEFT"/>// Lives through the catch handler.</FONT></TD></TR></TABLE>>];
"owner" -> "members" [arrowhead=vee,label="1. construct A, then B"];
"members" -> "log" [arrowhead=vee,label="2. record A+, then B+"];
"owner" -> "log" [arrowhead=vee,label="3. record body"];
"owner" -> "members" [arrowhead=vee,label="4. constructor throws; unwind"];
"members" -> "log" [arrowhead=vee,label="5. destroy B, then A: B- A-"];
"owner" -> "log" [arrowhead=vee,label="6. caller catch records caught"];
}