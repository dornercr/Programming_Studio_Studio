digraph G { graph [rankdir=TB, bgcolor="#fcfbff", pad="0.3", nodesep="0.4", ranksep="0.7"]; node [shape=plain]; edge [fontname="Arial", fontsize=13, color="#7955ac", penwidth=1.8];
"client" [label=<<TABLE WIDTH="330" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>Sample caller</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">int main() {
    Stock s(5);<BR ALIGN="LEFT"/>// Calls the public interface.</FONT></TD></TR></TABLE>>];
"type" [label=<<TABLE WIDTH="330" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>Stock public interface</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">int count() const { return count_; }<BR ALIGN="LEFT"/>bool take(int amount) {</FONT></TD></TR></TABLE>>];
"state" [label=<<TABLE WIDTH="330" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>Private value members</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">int count_;<BR ALIGN="LEFT"/>// Values belong to each object.</FONT></TD></TR></TABLE>>];
"client" -> "type" [style=dashed,arrowhead=vee,label="uses the public operations"];
"type" -> "state" [dir=both,arrowtail=diamond,arrowhead=none,label="object contains its value members"];
}