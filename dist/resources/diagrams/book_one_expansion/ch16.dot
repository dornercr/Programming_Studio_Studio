digraph G { graph [rankdir=TB, bgcolor="#fcfbff", pad="0.3", nodesep="0.4", ranksep="0.7"]; node [shape=plain]; edge [fontname="Arial", fontsize=13, color="#7955ac", penwidth=1.8];
"pending" [label=<<TABLE WIDTH="366" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>pending</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">enum class ParcelState { pending, ready };<BR ALIGN="LEFT"/>// The record begins awaiting validation.</FONT></TD></TR></TABLE>>];
"ready" [label=<<TABLE WIDTH="358" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>ready</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">parcel.state = ParcelState::ready;<BR ALIGN="LEFT"/>// Only the validated transition commits.</FONT></TD></TR></TABLE>>];
"pending" -> "ready" [arrowhead=vee,label="releaseParcel: weight in [1,100]"];
"pending" -> "pending" [arrowhead=vee,label="bad weight: false, unchanged"];
"ready" -> "ready" [arrowhead=vee,label="already ready: false, unchanged"];
}