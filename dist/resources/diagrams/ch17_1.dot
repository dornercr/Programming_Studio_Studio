"H" -> "M" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="164" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="164">vector stores snapshot<BR/>values</TD></TR></TABLE>>];
