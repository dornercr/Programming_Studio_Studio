digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"P" [label=<<TABLE BORDER="1" WIDTH="273" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="273" BGCOLOR="#eee9fb"><B>Subsystem: Parser</B></TD></TR><TR><TD WIDTH="273" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">const auto v = parser_.parse(text);</FONT></TD></TR></TABLE>>];
"V" [label=<<TABLE BORDER="1" WIDTH="200" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="200" BGCOLOR="#eee9fb"><B>Subsystem: Validator</B></TD></TR><TR><TD WIDTH="200" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">validator_.validate(v);</FONT></TD></TR></TABLE>>];
"S" [label=<<TABLE BORDER="1" WIDTH="252" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="252" BGCOLOR="#eee9fb"><B>Subsystem: Summarizer</B></TD></TR><TR><TD WIDTH="252" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return summarizer_.summarize(v);</FONT></TD></TR></TABLE>>];
"E" [label=<<TABLE BORDER="1" WIDTH="301" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="301" BGCOLOR="#eee9fb"><B>Failure annotation</B></TD></TR><TR><TD WIDTH="301" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">throw std::invalid_argument(&quot;integer&quot;);<BR ALIGN="LEFT"/>// An exception exits run immediately.</FONT></TD></TR></TABLE>>];
"P" -> "V" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="171" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="171">integer tokens accepted</TD></TR></TABLE>>];
"P" -> "E" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="116" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="116">syntax rejected</TD></TR></TABLE>>];
"V" -> "S" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="116" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="116">count and range<BR/>accepted</TD></TR></TABLE>>];
"V" -> "E" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="171" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="171">count or range rejected</TD></TR></TABLE>>];
}