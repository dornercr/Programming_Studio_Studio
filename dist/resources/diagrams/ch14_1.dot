digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"Q" [label=<<TABLE BORDER="1" WIDTH="336" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="336" BGCOLOR="#eee9fb"><B>Invoker: queue loops</B></TD></TR><TR><TD WIDTH="336" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::vector&lt;std::unique_ptr&lt;Command&gt;&gt; queue;</FONT></TD></TR></TABLE>>];
"C" [label=<<TABLE BORDER="1" WIDTH="217" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="217" BGCOLOR="#eee9fb"><B>Command interface</B></TD></TR><TR><TD WIDTH="217" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">virtual void execute() = 0;</FONT></TD></TR></TABLE>>];
"M" [label=<<TABLE BORDER="1" WIDTH="218" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="218" BGCOLOR="#eee9fb"><B>Concrete command: Move</B></TD></TR><TR><TD WIDTH="218" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">Marker&amp; marker_;</FONT></TD></TR></TABLE>>];
"R" [label=<<TABLE BORDER="1" WIDTH="190" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="190" BGCOLOR="#eee9fb"><B>Receiver: Marker</B></TD></TR><TR><TD WIDTH="190" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">int position_ = 0;</FONT></TD></TR></TABLE>>];
"Q" -> "C" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">unique_ptr owns each<BR/>command</TD></TR></TABLE>>];
"M" -> "C" [arrowhead=empty,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="171" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="171">Move implements Command</TD></TR></TABLE>>];
"M" -> "R" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">borrows receiver; no<BR/>ownership</TD></TR></TABLE>>];
}