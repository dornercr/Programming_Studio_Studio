digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"parent" [label=<<TABLE BORDER="1" WIDTH="301" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="301" BGCOLOR="#eee9fb"><B>Parent handle</B></TD></TR><TR><TD WIDTH="301" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Owns the original integer.<BR ALIGN="LEFT"/>auto parent = std::make_shared&lt;int&gt;(7);</FONT></TD></TR></TABLE>>];
"original" [label=<<TABLE BORDER="1" WIDTH="280" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="280" BGCOLOR="#eee9fb"><B>Original backing value</B></TD></TR><TR><TD WIDTH="280" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Parent still reads seven.<BR ALIGN="LEFT"/>assert(*parent == 7 &amp;&amp; *child == 9);</FONT></TD></TR></TABLE>>];
"child" [label=<<TABLE BORDER="1" WIDTH="441" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="441" BGCOLOR="#eee9fb"><B>Child handle</B></TD></TR><TR><TD WIDTH="441" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Detach before writing.<BR ALIGN="LEFT"/>if (!child.unique()) child = std::make_shared&lt;int&gt;(*child);</FONT></TD></TR></TABLE>>];
"private" [label=<<TABLE BORDER="1" WIDTH="209" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="209" BGCOLOR="#eee9fb"><B>Private backing value</B></TD></TR><TR><TD WIDTH="209" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Child now reads nine.<BR ALIGN="LEFT"/>*child = 9;</FONT></TD></TR></TABLE>>];
"parent" -> "original" [style=dashed, arrowhead=vee, color="#267b66",label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="130" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="130">shared_ptr owning<BR/>handle</TD></TR></TABLE>>];
"child" -> "private" [style=dashed, arrowhead=vee, color="#267b66",label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">separate shared_ptr<BR/>owning handle</TD></TR></TABLE>>];
}