digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"V" [label=<<TABLE BORDER="1" WIDTH="252" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="252" BGCOLOR="#eee9fb"><B>Import::run — fixed step</B></TD></TR><TR><TD WIDTH="252" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if (raw &lt; 0 || raw &gt; 100)<BR ALIGN="LEFT"/>// Reject before any conversion.</FONT></TD></TR></TABLE>>];
"C" [label=<<TABLE BORDER="1" WIDTH="252" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="252" BGCOLOR="#eee9fb"><B>convert — required step</B></TD></TR><TR><TD WIDTH="252" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">const int value = convert(raw);<BR ALIGN="LEFT"/>// Dispatch to the derived step.</FONT></TD></TR></TABLE>>];
"P" [label=<<TABLE BORDER="1" WIDTH="235" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="235" BGCOLOR="#eee9fb"><B>Import::run — fixed step</B></TD></TR><TR><TD WIDTH="235" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if (value &lt; 0 || value &gt; 200)<BR ALIGN="LEFT"/>result &lt;&lt; value &lt;&lt; ' ';</FONT></TD></TR></TABLE>>];
"S" [label=<<TABLE BORDER="1" WIDTH="245" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="245" BGCOLOR="#eee9fb"><B>suffix — optional hook</B></TD></TR><TR><TD WIDTH="245" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return result.str() + suffix();<BR ALIGN="LEFT"/>// Call the optional hook once.</FONT></TD></TR></TABLE>>];
"V" -> "C" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="116" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="116">all input valid</TD></TR></TABLE>>];
"C" -> "P" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="103" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="103">step returned</TD></TR></TABLE>>];
"P" -> "C" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="82" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="82">next input</TD></TR></TABLE>>];
"P" -> "S" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">all inputs converted</TD></TR></TABLE>>];
}