digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"O" [label=<<TABLE BORDER="1" WIDTH="336" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="336" BGCOLOR="#eee9fb"><B>Client-owned originals<BR/>originals</B></TD></TR><TR><TD WIDTH="336" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::vector&lt;std::unique_ptr&lt;Cue&gt;&gt; originals;<BR ALIGN="LEFT"/>// Own original cue objects.</FONT></TD></TR></TABLE>>];
"L" [label=<<TABLE BORDER="1" WIDTH="287" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="287" BGCOLOR="#eee9fb"><B>Concrete prototype<BR/>Original ListCue</B></TD></TR><TR><TD WIDTH="287" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::vector&lt;std::string&gt; names_;<BR ALIGN="LEFT"/>// Original strings remain unchanged.</FONT></TD></TR></TABLE>>];
"C" [label=<<TABLE BORDER="1" WIDTH="315" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="315" BGCOLOR="#eee9fb"><B>Client-owned clones<BR/>copies</B></TD></TR><TR><TD WIDTH="315" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::vector&lt;std::unique_ptr&lt;Cue&gt;&gt; copies;<BR ALIGN="LEFT"/>// Own new cue objects.</FONT></TD></TR></TABLE>>];
"N" [label=<<TABLE BORDER="1" WIDTH="287" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="287" BGCOLOR="#eee9fb"><B>Concrete prototype<BR/>Cloned ListCue</B></TD></TR><TR><TD WIDTH="287" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::vector&lt;std::string&gt; names_;<BR ALIGN="LEFT"/>// Independently copied names vector.</FONT></TD></TR></TABLE>>];
"O" -> "L" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="103" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="103">owns original</TD></TR></TABLE>>];
"C" -> "N" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="82" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="82">owns clone</TD></TR></TABLE>>];
"L" -> "N" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="137" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="137">clone copies value</TD></TR></TABLE>>];
}