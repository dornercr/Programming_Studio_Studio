digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"R" [label=<<TABLE BORDER="1" WIDTH="203" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="203" BGCOLOR="#eee9fb"><B>Collection: Readings</B></TD></TR><TR><TD WIDTH="203" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::vector&lt;int&gt; values_;</FONT></TD></TR></TABLE>>];
"A" [label=<<TABLE BORDER="1" WIDTH="190" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="190" BGCOLOR="#eee9fb"><B>Iterator: cursor</B></TD></TR><TR><TD WIDTH="190" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::size_t index_ = 0;</FONT></TD></TR></TABLE>>];
"B" [label=<<TABLE BORDER="1" WIDTH="209" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="209" BGCOLOR="#eee9fb"><B>Iterator: independent</B></TD></TR><TR><TD WIDTH="209" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">const Readings&amp; owner_;</FONT></TD></TR></TABLE>>];
"V" [label=<<TABLE BORDER="1" WIDTH="224" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="224" BGCOLOR="#eee9fb"><B>Owned element values</B></TD></TR><TR><TD WIDTH="224" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::vector&lt;int&gt; values_;<BR ALIGN="LEFT"/>// Read returns an int copy.</FONT></TD></TR></TABLE>>];
"R" -> "V" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="116" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="116">vector owns its<BR/>integers</TD></TR></TABLE>>];
"A" -> "R" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="171" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="171">borrows same collection</TD></TR></TABLE>>];
"B" -> "R" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="171" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="171">borrows same collection</TD></TR></TABLE>>];
