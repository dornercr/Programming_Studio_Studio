digraph G { graph [rankdir=LR, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"I" [label=<<TABLE BORDER="1" WIDTH="200" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="200" BGCOLOR="#eee9fb"><B>Concrete State: Idle</B></TD></TR><TR><TD WIDTH="200" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return &quot;idle&quot;;</FONT></TD></TR></TABLE>>];
"A" [label=<<TABLE BORDER="1" WIDTH="252" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="252" BGCOLOR="#eee9fb"><B>Concrete State: Active</B></TD></TR><TR><TD WIDTH="252" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if (event == Event::finish) {<BR ALIGN="LEFT"/>return std::make_unique&lt;Done&gt;();<BR ALIGN="LEFT"/>}<BR ALIGN="LEFT"/>// Active accepts finish.</FONT></TD></TR></TABLE>>];
"D" [label=<<TABLE BORDER="1" WIDTH="273" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="273" BGCOLOR="#eee9fb"><B>Concrete State: Done</B></TD></TR><TR><TD WIDTH="273" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if (event == Event::reset) { return<BR ALIGN="LEFT"/>std::make_unique&lt;Idle&gt;(); }<BR ALIGN="LEFT"/>// Done accepts reset.</FONT></TD></TR></TABLE>>];
"I" -> "A" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="110" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="110">begin accepted</TD></TR></TABLE>>];
"A" -> "D" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="116" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="116">finish accepted</TD></TR></TABLE>>];
"D" -> "I" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="110" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="110">reset accepted</TD></TR></TABLE>>];
}