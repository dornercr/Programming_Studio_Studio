digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"first" [label=<<TABLE BORDER="1" WIDTH="308" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="308" BGCOLOR="#eee9fb"><B>Initialize from the first item</B></TD></TR><TR><TD WIDTH="308" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">int best=v.at(0);<BR ALIGN="LEFT"/>// Empty input throws std::out_of_range.</FONT></TD></TR></TABLE>>];
"test" [label=<<TABLE BORDER="1" WIDTH="294" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="294" BGCOLOR="#eee9fb"><B>Visit each remaining index</B></TD></TR><TR><TD WIDTH="294" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">for(std::size_t i=1;i&lt;v.size();++i)<BR ALIGN="LEFT"/>// i never reaches the index v.size().</FONT></TD></TR></TABLE>>];
"update" [label=<<TABLE BORDER="1" WIDTH="308" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="308" BGCOLOR="#eee9fb"><B>Replace only with a larger value</B></TD></TR><TR><TD WIDTH="308" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if(v[i]&gt;best) best=v[i];<BR ALIGN="LEFT"/>// best is the largest item seen so far.</FONT></TD></TR></TABLE>>];
"return" [label=<<TABLE BORDER="1" WIDTH="266" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="266" BGCOLOR="#eee9fb"><B>Return the result</B></TD></TR><TR><TD WIDTH="266" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return best;<BR ALIGN="LEFT"/>// For 4, 9, 2, 7 the result is 9.</FONT></TD></TR></TABLE>>];
"first" -> "test" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="123" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="123">begin at index 1</TD></TR></TABLE>>];
"test" -> "update" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="164" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="164">another element exists</TD></TR></TABLE>>];
"update" -> "test" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="164" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="164">advance and test again</TD></TR></TABLE>>];
"test" -> "return" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">all elements visited</TD></TR></TABLE>>];
}