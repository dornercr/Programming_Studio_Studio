"M" [label=<<TABLE BORDER="1" WIDTH="266" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="266" BGCOLOR="#eee9fb"><B>Mediator: Form</B></TD></TR><TR><TD WIDTH="266" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">const bool ready = name_.filled();</FONT></TD></TR></TABLE>>];
