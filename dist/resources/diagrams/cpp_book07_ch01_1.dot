digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"queue" [label=<<TABLE BORDER="1" WIDTH="259" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="259" BGCOLOR="#eee9fb"><B>Initial queue</B></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::vector&lt;int&gt; jobs{4};<BR ALIGN="LEFT"/>constexpr std::size_t capacity=2;<BR ALIGN="LEFT"/>// One slot is initially used.</FONT></TD></TR></TABLE>>];
"guard" [label=<<TABLE BORDER="1" WIDTH="301" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="301" BGCOLOR="#eee9fb"><B>Check value and capacity</B></TD></TR><TR><TD WIDTH="301" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if(x&lt;0||x&gt;100||jobs.size()==capacity)<BR ALIGN="LEFT"/>    return false;<BR ALIGN="LEFT"/>// Failure leaves the vector unchanged.</FONT></TD></TR></TABLE>>];
"append" [label=<<TABLE BORDER="1" WIDTH="308" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="308" BGCOLOR="#eee9fb"><B>Commit accepted work</B></TD></TR><TR><TD WIDTH="308" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">jobs.push_back(x);<BR ALIGN="LEFT"/>return true;<BR ALIGN="LEFT"/>// Mutation follows the admission check.</FONT></TD></TR></TABLE>>];
"check" [label=<<TABLE BORDER="1" WIDTH="315" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="315" BGCOLOR="#eee9fb"><B>Check the final state</B></TD></TR><TR><TD WIDTH="315" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if(jobs!=std::vector&lt;int&gt;{4,7})return 1;<BR ALIGN="LEFT"/>// 101 is invalid; 8 is rejected as full.</FONT></TD></TR></TABLE>>];
"queue" -> "guard" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">calls with 7, 101, 8</TD></TR></TABLE>>];
"guard" -> "append" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">only when all guards<BR/>pass</TD></TR></TABLE>>];
"append" -> "check" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">after all three calls</TD></TR></TABLE>>];
"guard" -> "check" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">rejected calls do not<BR/>append</TD></TR></TABLE>>];
}