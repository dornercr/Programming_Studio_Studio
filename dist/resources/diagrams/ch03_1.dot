digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"D" [label=<<TABLE BORDER="1" WIDTH="294" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="294" BGCOLOR="#eee9fb"><B>Builder draft<BR/>PlanBuilder</B></TD></TR><TR><TD WIDTH="294" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::string title_;<BR ALIGN="LEFT"/>std::vector&lt;int&gt; minutes_;<BR ALIGN="LEFT"/>// Incomplete state is permitted here.</FONT></TD></TR></TABLE>>];
"A" [label=<<TABLE BORDER="1" WIDTH="224" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="224" BGCOLOR="#eee9fb"><B>Builder step<BR/>PlanBuilder::add</B></TD></TR><TR><TD WIDTH="224" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">minutes_.push_back(minutes);<BR ALIGN="LEFT"/>return *this;</FONT></TD></TR></TABLE>>];
"B" [label=<<TABLE BORDER="1" WIDTH="273" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="273" BGCOLOR="#eee9fb"><B>Finish step<BR/>PlanBuilder::build</B></TD></TR><TR><TD WIDTH="273" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if (total &gt; 90)<BR ALIGN="LEFT"/>// Also require title and activity.</FONT></TD></TR></TABLE>>];
"P" [label=<<TABLE BORDER="1" WIDTH="273" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="273" BGCOLOR="#eee9fb"><B>Product<BR/>Plan</B></TD></TR><TR><TD WIDTH="273" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return Plan(title_, minutes_);<BR ALIGN="LEFT"/>// Product owns independent copies.</FONT></TD></TR></TABLE>>];
"D" -> "A" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">valid next duration</TD></TR></TABLE>>];
"A" -> "D" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="130" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="130">continue drafting</TD></TR></TABLE>>];
"D" -> "B" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="116" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="116">build requested</TD></TR></TABLE>>];
"B" -> "P" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">all final rules hold</TD></TR></TABLE>>];
}