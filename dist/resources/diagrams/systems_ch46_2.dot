digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"producer" [label=<<TABLE BORDER="1" WIDTH="224" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="224" BGCOLOR="#eee9fb"><B>Producer</B></TD></TR><TR><TD WIDTH="224" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Write before publication.<BR ALIGN="LEFT"/>payload = 42;</FONT></TD></TR></TABLE>>];
"ready" [label=<<TABLE BORDER="1" WIDTH="245" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="245" BGCOLOR="#eee9fb"><B>Atomic readiness</B></TD></TR><TR><TD WIDTH="245" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Initially false.<BR ALIGN="LEFT"/>std::atomic&lt;bool&gt; ready{false};</FONT></TD></TR></TABLE>>];
"consumer" [label=<<TABLE BORDER="1" WIDTH="245" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="245" BGCOLOR="#eee9fb"><B>Consumer</B></TD></TR><TR><TD WIDTH="245" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Read after acquire succeeds.<BR ALIGN="LEFT"/>observed = payload;</FONT></TD></TR></TABLE>>];
"producer" -> "ready" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">release-store true<BR/>after writing payload</TD></TR></TABLE>>];
"ready" -> "consumer" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">acquire-load observes<BR/>that true</TD></TR></TABLE>>];
"producer" -> "consumer" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="164" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="164">prior payload write<BR/>happens-before payload<BR/>read</TD></TR></TABLE>>];
}