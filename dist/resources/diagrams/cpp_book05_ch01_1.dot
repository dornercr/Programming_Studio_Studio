digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"header" [label=<<TABLE BORDER="1" WIDTH="273" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="273" BGCOLOR="#eee9fb"><B>Public header</B></TD></TR><TR><TD WIDTH="273" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// include/calc/add.hpp<BR ALIGN="LEFT"/>int add(int a, int b);<BR ALIGN="LEFT"/>// Declaration: the call signature.</FONT></TD></TR></TABLE>>];
"impl" [label=<<TABLE BORDER="1" WIDTH="301" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="301" BGCOLOR="#eee9fb"><B>Implementation</B></TD></TR><TR><TD WIDTH="301" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// src/add.cpp<BR ALIGN="LEFT"/>#include &quot;calc/add.hpp&quot;<BR ALIGN="LEFT"/>int add(int a, int b) { return a + b; }</FONT></TD></TR></TABLE>>];
"main" [label=<<TABLE BORDER="1" WIDTH="322" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="322" BGCOLOR="#eee9fb"><B>Application</B></TD></TR><TR><TD WIDTH="322" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// app/main.cpp<BR ALIGN="LEFT"/>#include &quot;calc/add.hpp&quot;<BR ALIGN="LEFT"/>add(20, 22)<BR ALIGN="LEFT"/>// The caller uses the public declaration.</FONT></TD></TR></TABLE>>];
"link" [label=<<TABLE BORDER="1" WIDTH="301" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="301" BGCOLOR="#eee9fb"><B>Linked program</B></TD></TR><TR><TD WIDTH="301" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Link both compiled .cpp files.<BR ALIGN="LEFT"/>// The call resolves to one definition.<BR ALIGN="LEFT"/>// Running the program prints 42.</FONT></TD></TR></TABLE>>];
"impl" -> "header" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">includes declaration</TD></TR></TABLE>>];
"main" -> "header" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">includes declaration</TD></TR></TABLE>>];
"impl" -> "link" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">compiled definition</TD></TR></TABLE>>];
"main" -> "link" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="116" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="116">compiled caller</TD></TR></TABLE>>];
}