digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"input" [label=<<TABLE BORDER="1" WIDTH="294" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="294" BGCOLOR="#eee9fb"><B>Establish the starting state</B></TD></TR><TR><TD WIDTH="294" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Inputs or state for this execution.<BR ALIGN="LEFT"/>const std::size_t limit = 100;<BR ALIGN="LEFT"/>const std::size_t count = 9;</FONT></TD></TR></TABLE>>];
"mechanism" [label=<<TABLE BORDER="1" WIDTH="413" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="413" BGCOLOR="#eee9fb"><B>Check multiplication before<BR/>allocating</B></TD></TR><TR><TD WIDTH="413" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Focus: follow the operation below.<BR ALIGN="LEFT"/>const bool fits = width == 0 || count &lt;= limit / width;</FONT></TD></TR></TABLE>>];
"observe" [label=<<TABLE BORDER="1" WIDTH="364" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="364" BGCOLOR="#eee9fb"><B>Observe the promised result</B></TD></TR><TR><TD WIDTH="364" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Check the result; retain the exact output.<BR ALIGN="LEFT"/>std::cout &lt;&lt; (fits ? &quot;fits&quot; : &quot;reject&quot;) &lt;&lt; '\n';</FONT></TD></TR></TABLE>>];
"input" -> "mechanism" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">Execute the selected<BR/>operation</TD></TR></TABLE>>];
"mechanism" -> "observe" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="130" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="130">Observe after the<BR/>operation</TD></TR></TABLE>>];
}