digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch10/main.cpp:67-72<BR ALIGN="LEFT"/>    Importer importer;<BR ALIGN="LEFT"/>    const auto result = importer.run(&quot;4 6&quot;);<BR ALIGN="LEFT"/>    check(result.count == 2 &amp;&amp; result.total == 10);<BR ALIGN="LEFT"/>    check(importer.run(&quot;-100 100&quot;).total == 0);<BR ALIGN="LEFT"/>    check(importer.run(&quot;0&quot;).count == 1);<BR ALIGN="LEFT"/>    for (const std::string bad : {&quot;&quot;, &quot;4x&quot;, &quot;101&quot;, &quot;1.5&quot;}) {</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>One facade method fixes the call order while<BR ALIGN="LEFT"/>member objects retain separate parsing,<BR ALIGN="LEFT"/>validation, and calculation<BR ALIGN="LEFT"/>responsibilities. No polymorphism is needed.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Malformed tokens never become accepted<BR ALIGN="LEFT"/>partial integers.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Check only from_chars.ec and ignore its<BR ALIGN="LEFT"/>stopping pointer. The malformed token 4x may<BR ALIGN="LEFT"/>be accepted as 4. A valid numeric prefix is<BR ALIGN="LEFT"/>not a valid complete token.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch10/main.cpp:67-72<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch10/main.cpp:73-78<BR ALIGN="LEFT"/>        bool rejected = false;<BR ALIGN="LEFT"/>        try { static_cast&lt;void&gt;(importer.run(bad)); }<BR ALIGN="LEFT"/>        catch (const std::invalid_argument&amp;) { rejected = true; }<BR ALIGN="LEFT"/>        check(rejected);<BR ALIGN="LEFT"/>    }<BR ALIGN="LEFT"/>    std::string many;</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>One facade method fixes the call order while<BR ALIGN="LEFT"/>member objects retain separate parsing,<BR ALIGN="LEFT"/>validation, and calculation<BR ALIGN="LEFT"/>responsibilities. No polymorphism is needed.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Summarizer is reached only after Validator<BR ALIGN="LEFT"/>accepts the vector.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Summarize before validating. Out-of-contract<BR ALIGN="LEFT"/>values can reach arithmetic; sufficiently<BR ALIGN="LEFT"/>large totals can overflow int. The operation<BR ALIGN="LEFT"/>that establishes the precondition was<BR ALIGN="LEFT"/>delayed until after its consumer.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch10/main.cpp:73-78<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch10/main.cpp:79-84<BR ALIGN="LEFT"/>    for (int i = 0; i &lt; 1000; ++i) many += &quot;100 &quot;;<BR ALIGN="LEFT"/>    check(importer.run(many).total == 100000);<BR ALIGN="LEFT"/>    bool too_many = false;<BR ALIGN="LEFT"/>    try { static_cast&lt;void&gt;(importer.run(many + &quot;0&quot;)); }<BR ALIGN="LEFT"/>    catch (const std::invalid_argument&amp;) { too_many = true; }<BR ALIGN="LEFT"/>    check(too_many);</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>One facade method fixes the call order while<BR ALIGN="LEFT"/>member objects retain separate parsing,<BR ALIGN="LEFT"/>validation, and calculation<BR ALIGN="LEFT"/>responsibilities. No polymorphism is needed.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Returned Stats owns values and does not<BR ALIGN="LEFT"/>refer to local storage.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Treat an empty vector as a valid zero total.<BR ALIGN="LEFT"/>Empty input becomes count=0 total=0 instead<BR ALIGN="LEFT"/>of being rejected. Zero readings and one<BR ALIGN="LEFT"/>reading whose value is zero are different<BR ALIGN="LEFT"/>cases.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch10/main.cpp:79-84<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}