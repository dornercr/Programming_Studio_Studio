digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch22/main.cpp:73-78<BR ALIGN="LEFT"/>    std::vector&lt;std::unique_ptr&lt;Part&gt;&gt; parts;<BR ALIGN="LEFT"/>    parts.push_back(std::make_unique&lt;Bolts&gt;(3));<BR ALIGN="LEFT"/>    parts.push_back(std::make_unique&lt;Cable&gt;(2));<BR ALIGN="LEFT"/>    Price price;<BR ALIGN="LEFT"/>    for (const auto&amp; part : parts) { part-&gt;accept(price); }<BR ALIGN="LEFT"/>    check(price.cents() == 95);</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each Part accepts a Visitor, and each<BR ALIGN="LEFT"/>concrete part forwards its own precise type.<BR ALIGN="LEFT"/>Price implements the type-specific<BR ALIGN="LEFT"/>operations and retains a checked running<BR ALIGN="LEFT"/>total.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Each part quantity is in 0 through 100.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Call visit directly with a Part reference<BR ALIGN="LEFT"/>and expect the Bolts overload to be chosen<BR ALIGN="LEFT"/>dynamically. The call does not compile with<BR ALIGN="LEFT"/>this interface because neither<BR ALIGN="LEFT"/>concrete-reference overload accepts a Part<BR ALIGN="LEFT"/>reference. Overload resolution uses the<BR ALIGN="LEFT"/>static expression type; accept supplies the<BR ALIGN="LEFT"/>missing concrete-type step.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch22/main.cpp:73-78<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch22/main.cpp:79-84<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;price cents: &quot; &lt;&lt; price.cents() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    Price empty;<BR ALIGN="LEFT"/>    check(empty.cents() == 0);<BR ALIGN="LEFT"/>    Bolts zero(0);<BR ALIGN="LEFT"/>    zero.accept(empty);<BR ALIGN="LEFT"/>    check(empty.cents() == 0);</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each Part accepts a Visitor, and each<BR ALIGN="LEFT"/>concrete part forwards its own precise type.<BR ALIGN="LEFT"/>Price implements the type-specific<BR ALIGN="LEFT"/>operations and retains a checked running<BR ALIGN="LEFT"/>total.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Price is between zero and one million cents.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Reuse one Price object for two independent<BR ALIGN="LEFT"/>identical orders without resetting it. The<BR ALIGN="LEFT"/>second displayed total becomes 190 instead<BR ALIGN="LEFT"/>of 95. The visitor retains a running total<BR ALIGN="LEFT"/>across visits.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch22/main.cpp:79-84<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch22/main.cpp:85-90<BR ALIGN="LEFT"/>    bool invalid = false;<BR ALIGN="LEFT"/>    try { Cable bad(-1); }<BR ALIGN="LEFT"/>    catch (const std::out_of_range&amp;) { invalid = true; }<BR ALIGN="LEFT"/>    check(invalid);<BR ALIGN="LEFT"/>    Cable reel(100);<BR ALIGN="LEFT"/>    Price capped;</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each Part accepts a Visitor, and each<BR ALIGN="LEFT"/>concrete part forwards its own precise type.<BR ALIGN="LEFT"/>Price implements the type-specific<BR ALIGN="LEFT"/>operations and retains a checked running<BR ALIGN="LEFT"/>total.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>A visitor reads parts without taking<BR ALIGN="LEFT"/>ownership.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Call visit directly with a Part reference<BR ALIGN="LEFT"/>and expect the Bolts overload to be chosen<BR ALIGN="LEFT"/>dynamically. The call does not compile with<BR ALIGN="LEFT"/>this interface because neither<BR ALIGN="LEFT"/>concrete-reference overload accepts a Part<BR ALIGN="LEFT"/>reference. Overload resolution uses the<BR ALIGN="LEFT"/>static expression type; accept supplies the<BR ALIGN="LEFT"/>missing concrete-type step.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch22/main.cpp:85-90<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
