digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch02/main.cpp:94-99<BR ALIGN="LEFT"/>    PlainFactory plain;<BR ALIGN="LEFT"/>    FramedFactory framed;<BR ALIGN="LEFT"/>    check(round_trip(plain, 7) == &quot;7&quot;);<BR ALIGN="LEFT"/>    check(round_trip(framed, 7) == &quot;[7]&quot;);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;plain=&quot; &lt;&lt; round_trip(plain, 7) &lt;&lt; '\n';<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;framed=&quot; &lt;&lt; round_trip(framed, 7) &lt;&lt; '\n';</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>CodecFactory groups two independent creation<BR ALIGN="LEFT"/>operations under one family choice.<BR ALIGN="LEFT"/>round_trip depends only on factory and<BR ALIGN="LEFT"/>product interfaces, and explicitly checks<BR ALIGN="LEFT"/>the compatibility invariant.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>For each supported digit, read(write(value))<BR ALIGN="LEFT"/>equals value within one family.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Pair the framed writer with the plain<BR ALIGN="LEFT"/>reader. Writing 7 produces [7], which the<BR ALIGN="LEFT"/>plain reader rejects. Matching interface<BR ALIGN="LEFT"/>types do not imply matching wire formats.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch02/main.cpp:94-99<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch02/main.cpp:100-105<BR ALIGN="LEFT"/>    for (int value = 0; value &lt;= 9; ++value) {<BR ALIGN="LEFT"/>        round_trip(plain, value);<BR ALIGN="LEFT"/>        round_trip(framed, value);<BR ALIGN="LEFT"/>    }<BR ALIGN="LEFT"/>    bool rejected = false;<BR ALIGN="LEFT"/>    try { plain.decoder()-&gt;read(framed.encoder()-&gt;write(7)); }</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>CodecFactory groups two independent creation<BR ALIGN="LEFT"/>operations under one family choice.<BR ALIGN="LEFT"/>round_trip depends only on factory and<BR ALIGN="LEFT"/>product interfaces, and explicitly checks<BR ALIGN="LEFT"/>the compatibility invariant.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Products returned by the supplied factories<BR ALIGN="LEFT"/>are non-null.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Check only brackets in FramedDecoder. [x]<BR ALIGN="LEFT"/>passes the structural check and could<BR ALIGN="LEFT"/>produce a non-digit value. A correct frame<BR ALIGN="LEFT"/>does not prove that its enclosed character<BR ALIGN="LEFT"/>is valid.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch02/main.cpp:100-105<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch02/main.cpp:106-111<BR ALIGN="LEFT"/>    catch (const std::invalid_argument&amp;) { rejected = true; }<BR ALIGN="LEFT"/>    check(rejected);<BR ALIGN="LEFT"/>    rejected = false;<BR ALIGN="LEFT"/>    try { round_trip(plain, 10); }<BR ALIGN="LEFT"/>    catch (const std::invalid_argument&amp;) { rejected = true; }<BR ALIGN="LEFT"/>    check(rejected);</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>CodecFactory groups two independent creation<BR ALIGN="LEFT"/>operations under one family choice.<BR ALIGN="LEFT"/>round_trip depends only on factory and<BR ALIGN="LEFT"/>product interfaces, and explicitly checks<BR ALIGN="LEFT"/>the compatibility invariant.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Decoders check structure before indexing or<BR ALIGN="LEFT"/>extracting content.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Pair the framed writer with the plain<BR ALIGN="LEFT"/>reader. Writing 7 produces [7], which the<BR ALIGN="LEFT"/>plain reader rejects. Matching interface<BR ALIGN="LEFT"/>types do not imply matching wire formats.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch02/main.cpp:106-111<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}