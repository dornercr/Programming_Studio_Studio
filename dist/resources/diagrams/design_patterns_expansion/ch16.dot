digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch16/main.cpp:61-66<BR ALIGN="LEFT"/>    Form form;<BR ALIGN="LEFT"/>    check(!form.enabled() &amp;&amp; !form.submit());<BR ALIGN="LEFT"/>    form.name(&quot;Mina&quot;);<BR ALIGN="LEFT"/>    check(!form.enabled());<BR ALIGN="LEFT"/>    form.accept(true);<BR ALIGN="LEFT"/>    check(form.enabled() &amp;&amp; form.submit());</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Form owns its controls and implements a<BR ALIGN="LEFT"/>small Events interface. The field reports<BR ALIGN="LEFT"/>changes, the mediator reads all relevant<BR ALIGN="LEFT"/>state, and the button updates silently.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Button readiness equals filled name AND<BR ALIGN="LEFT"/>accepted consent after each public change.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>NameField enables save whenever text is<BR ALIGN="LEFT"/>nonempty. Entering Mina can enable save<BR ALIGN="LEFT"/>while consent is false. One component cannot<BR ALIGN="LEFT"/>decide a rule that also depends on another<BR ALIGN="LEFT"/>state.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch16/main.cpp:61-66<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch16/main.cpp:67-72<BR ALIGN="LEFT"/>    check(form.saved() == 1);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;ready: &quot; &lt;&lt; form.enabled() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    form.name(&quot;Mina&quot;);<BR ALIGN="LEFT"/>    check(form.enabled());<BR ALIGN="LEFT"/>    form.name(&quot;&quot;);<BR ALIGN="LEFT"/>    check(!form.enabled() &amp;&amp; !form.submit());</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Form owns its controls and implements a<BR ALIGN="LEFT"/>small Events interface. The field reports<BR ALIGN="LEFT"/>changes, the mediator reads all relevant<BR ALIGN="LEFT"/>state, and the button updates silently.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Disabled submit leaves the saved count<BR ALIGN="LEFT"/>unchanged.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Use a default copy of a Form whose field<BR ALIGN="LEFT"/>borrows its mediator. A copied field can<BR ALIGN="LEFT"/>send changes to the original Form. Copying a<BR ALIGN="LEFT"/>reference preserves its original target<BR ALIGN="LEFT"/>rather than rebinding it.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch16/main.cpp:67-72<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch16/main.cpp:73-78<BR ALIGN="LEFT"/>    check(form.saved() == 1);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;empty name: &quot; &lt;&lt; form.enabled() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    form.name(&quot;Mina&quot;);<BR ALIGN="LEFT"/>    form.accept(false);<BR ALIGN="LEFT"/>    check(!form.enabled());<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;saved: &quot; &lt;&lt; form.saved() &lt;&lt; '\n';</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Form owns its controls and implements a<BR ALIGN="LEFT"/>small Events interface. The field reports<BR ALIGN="LEFT"/>changes, the mediator reads all relevant<BR ALIGN="LEFT"/>state, and the button updates silently.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>A field callback always reaches its<BR ALIGN="LEFT"/>containing live Form.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>NameField enables save whenever text is<BR ALIGN="LEFT"/>nonempty. Entering Mina can enable save<BR ALIGN="LEFT"/>while consent is false. One component cannot<BR ALIGN="LEFT"/>decide a rule that also depends on another<BR ALIGN="LEFT"/>state.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch16/main.cpp:73-78<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
