digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch14/main.cpp:53-58<BR ALIGN="LEFT"/>    Marker marker;<BR ALIGN="LEFT"/>    std::vector&lt;std::unique_ptr&lt;Command&gt;&gt; queue;<BR ALIGN="LEFT"/>    queue.push_back(std::make_unique&lt;Move&gt;(marker, 3));<BR ALIGN="LEFT"/>    queue.push_back(std::make_unique&lt;Move&gt;(marker, 7));<BR ALIGN="LEFT"/>    check(marker.position() == 0);<BR ALIGN="LEFT"/>    for (auto&amp; command : queue) { command-&gt;execute(); }</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Move holds the receiver, destination, prior<BR ALIGN="LEFT"/>position, and an applied flag. The queue<BR ALIGN="LEFT"/>owns commands but borrows no internal marker<BR ALIGN="LEFT"/>storage. Receiver validation happens before<BR ALIGN="LEFT"/>the command commits success.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>The marker stays within its allowed range.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Capture before_ in the constructor. Both<BR ALIGN="LEFT"/>queued moves may save zero, so undoing the<BR ALIGN="LEFT"/>second jumps from seven directly to zero<BR ALIGN="LEFT"/>instead of three. Both objects are<BR ALIGN="LEFT"/>constructed before either action executes.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch14/main.cpp:53-58<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch14/main.cpp:59-64<BR ALIGN="LEFT"/>    check(marker.position() == 7);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;after queue: &quot; &lt;&lt; marker.position() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    bool repeated = false;<BR ALIGN="LEFT"/>    try { queue.back()-&gt;execute(); }<BR ALIGN="LEFT"/>    catch (const std::logic_error&amp;) { repeated = true; }<BR ALIGN="LEFT"/>    check(repeated &amp;&amp; marker.position() == 7);</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Move holds the receiver, destination, prior<BR ALIGN="LEFT"/>position, and an applied flag. The queue<BR ALIGN="LEFT"/>owns commands but borrows no internal marker<BR ALIGN="LEFT"/>storage. Receiver validation happens before<BR ALIGN="LEFT"/>the command commits success.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Only successful executions set applied_<BR ALIGN="LEFT"/>true.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Undo the commands in insertion order. After<BR ALIGN="LEFT"/>moves to three and seven, the final marker<BR ALIGN="LEFT"/>becomes three instead of zero. The first<BR ALIGN="LEFT"/>restoration to zero is overwritten by the<BR ALIGN="LEFT"/>second restoration to three.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch14/main.cpp:59-64<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch14/main.cpp:65-70<BR ALIGN="LEFT"/>    for (auto it = queue.rbegin(); it != queue.rend(); ++it) {<BR ALIGN="LEFT"/>        (*it)-&gt;undo();<BR ALIGN="LEFT"/>    }<BR ALIGN="LEFT"/>    check(marker.position() == 0);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;after undo: &quot; &lt;&lt; marker.position() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    bool rejected = false;</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Move holds the receiver, destination, prior<BR ALIGN="LEFT"/>position, and an applied flag. The queue<BR ALIGN="LEFT"/>owns commands but borrows no internal marker<BR ALIGN="LEFT"/>storage. Receiver validation happens before<BR ALIGN="LEFT"/>the command commits success.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Commands must not outlive their borrowed<BR ALIGN="LEFT"/>receiver.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Capture before_ in the constructor. Both<BR ALIGN="LEFT"/>queued moves may save zero, so undoing the<BR ALIGN="LEFT"/>second jumps from seven directly to zero<BR ALIGN="LEFT"/>instead of three. Both objects are<BR ALIGN="LEFT"/>constructed before either action executes.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch14/main.cpp:65-70<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}