digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"queue" [label=<<TABLE BORDER="1" WIDTH="329" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="329" BGCOLOR="#eee9fb"><B>Queue</B></TD></TR><TR><TD WIDTH="329" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// push, pop, and close share one contract.<BR ALIGN="LEFT"/>class Queue {</FONT></TD></TR></TABLE>>];
"storage" [label=<<TABLE BORDER="1" WIDTH="273" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="273" BGCOLOR="#eee9fb"><B>Owned item storage</B></TD></TR><TR><TD WIDTH="273" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Accepted integers in FIFO order.<BR ALIGN="LEFT"/>std::deque&lt;int&gt; items_;</FONT></TD></TR></TABLE>>];
"sync" [label=<<TABLE BORDER="1" WIDTH="343" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="343" BGCOLOR="#eee9fb"><B>Owned synchronization</B></TD></TR><TR><TD WIDTH="343" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// One mutex and two condition variables.<BR ALIGN="LEFT"/>std::mutex mutex_;<BR ALIGN="LEFT"/>std::condition_variable readable_, writable_;</FONT></TD></TR></TABLE>>];
"queue" -> "storage" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="164" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="164">contains 0 to capacity<BR/>items</TD></TR></TABLE>>];
"queue" -> "sync" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="171" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="171">members live with Queue</TD></TR></TABLE>>];
