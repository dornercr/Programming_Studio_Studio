digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"P" [label=<<TABLE BORDER="1" WIDTH="235" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="235" BGCOLOR="#eee9fb"><B>Composite: project Group</B></TD></TR><TR><TD WIDTH="235" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">Children children_;</FONT></TD></TR></TABLE>>];
"G" [label=<<TABLE BORDER="1" WIDTH="218" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="218" BGCOLOR="#eee9fb"><B>Composite: child Group</B></TD></TR><TR><TD WIDTH="218" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return total;</FONT></TD></TR></TABLE>>];
"S" [label=<<TABLE BORDER="1" WIDTH="190" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="190" BGCOLOR="#eee9fb"><B>Leaf: Step</B></TD></TR><TR><TD WIDTH="190" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">int minutes_;</FONT></TD></TR></TABLE>>];
"W" [label=<<TABLE BORDER="1" WIDTH="252" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="252" BGCOLOR="#eee9fb"><B>Component: Work</B></TD></TR><TR><TD WIDTH="252" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">virtual int minutes() const = 0;</FONT></TD></TR></TABLE>>];
"P" -> "G" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">owns one child group</TD></TR></TABLE>>];
"P" -> "S" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">owns five-minute leaf</TD></TR></TABLE>>];
"G" -> "S" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">owns ten- and<BR/>twenty-minute leaves</TD></TR></TABLE>>];
"G" -> "W" [arrowhead=empty,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">Group implements Work</TD></TR></TABLE>>];
}