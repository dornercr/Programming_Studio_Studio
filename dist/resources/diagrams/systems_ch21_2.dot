digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"ready" [label=<<TABLE BORDER="1" WIDTH="231" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="231" BGCOLOR="#eee9fb"><B>Ready</B></TD></TR><TR><TD WIDTH="231" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Eligible to be dispatched.<BR ALIGN="LEFT"/>State process = State::Ready;</FONT></TD></TR></TABLE>>];
"running" [label=<<TABLE BORDER="1" WIDTH="420" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="420" BGCOLOR="#eee9fb"><B>Running</B></TD></TR><TR><TD WIDTH="420" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Dispatch follows Ready.<BR ALIGN="LEFT"/>assert(transition(process,State::Ready,State::Running));</FONT></TD></TR></TABLE>>];
"waiting" [label=<<TABLE BORDER="1" WIDTH="434" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="434" BGCOLOR="#eee9fb"><B>Waiting</B></TD></TR><TR><TD WIDTH="434" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// A wait event blocks execution.<BR ALIGN="LEFT"/>assert(transition(process,State::Running,State::Waiting));</FONT></TD></TR></TABLE>>];
"ready" -> "running" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="69" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="69">dispatch</TD></TR></TABLE>>];
"running" -> "waiting" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="137" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="137">block for an event</TD></TR></TABLE>>];
"waiting" -> "ready" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">event completes: wake<BR/>up</TD></TR></TABLE>>];
}