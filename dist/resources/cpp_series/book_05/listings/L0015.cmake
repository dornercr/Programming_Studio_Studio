cmake_minimum_required(VERSION 3.24)
project(HarborCalibration LANGUAGES CXX)
include(CTest)
add_library(calibration STATIC ../calibration.cpp)
target_compile_features(calibration PUBLIC cxx_std_20)
target_include_directories(calibration PUBLIC "${CMAKE_CURRENT_LIST_DIR}/..")
set_target_properties(calibration PROPERTIES CXX_EXTENSIONS OFF)
add_executable(calibration_test ../main.cpp)
target_include_directories(calibration_test PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../../../support")
target_link_libraries(calibration_test PRIVATE calibration)
if(MSVC)
  target_compile_options(calibration PRIVATE /W4)
else()
  target_compile_options(calibration PRIVATE -Wall -Wextra -Wpedantic)
endif()
add_test(NAME calibration_contract COMMAND calibration_test)
