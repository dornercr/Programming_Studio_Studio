cmake_minimum_required(VERSION 3.24)
project(HarborDispatch VERSION 1.0.0 LANGUAGES CXX)
include(CTest)
find_package(Threads REQUIRED)
find_package(SQLite3 REQUIRED)
find_package(Python3 COMPONENTS Interpreter REQUIRED)
option(HARBOR_SANITIZERS "Enable AddressSanitizer and UndefinedBehaviorSanitizer" OFF)
add_library(harbor_options INTERFACE)
target_compile_features(harbor_options INTERFACE cxx_std_20)
set(CMAKE_CXX_EXTENSIONS OFF)
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  target_compile_options(harbor_options INTERFACE -Wall -Wextra -Wpedantic)
  if(HARBOR_SANITIZERS)
    target_compile_options(harbor_options INTERFACE -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(harbor_options INTERFACE -fsanitize=address,undefined)
  endif()
endif()
add_library(harbor_core INTERFACE)
target_include_directories(harbor_core INTERFACE $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>)
target_link_libraries(harbor_core INTERFACE harbor_options Threads::Threads)
add_library(harbor_store src/store.cpp)
target_link_libraries(harbor_store PUBLIC harbor_core SQLite::SQLite3)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "The executable transport lab targets Linux; pure headers can be ported separately.")
endif()
add_library(harbor_net src/net.cpp)
target_link_libraries(harbor_net PUBLIC harbor_core)
foreach(app worker gateway client)
  add_executable(harbor_${app} src/${app}.cpp)
  target_link_libraries(harbor_${app} PRIVATE harbor_net harbor_store)
  install(TARGETS harbor_${app} RUNTIME DESTINATION bin)
endforeach()
file(GLOB CHAPTER_SOURCES CONFIGURE_DEPENDS examples/ch*.cpp)
foreach(file IN LISTS CHAPTER_SOURCES)
  get_filename_component(name ${file} NAME_WE)
  add_executable(${name} ${file})
  target_link_libraries(${name} PRIVATE harbor_net harbor_store)
  add_test(NAME ${name} COMMAND ${name})
  set_tests_properties(${name} PROPERTIES TIMEOUT 15)
endforeach()
if(BUILD_TESTING)
  add_executable(core_regression tests/core_tests.cpp)
  target_link_libraries(core_regression PRIVATE harbor_core)
  foreach(case codec policy routing cache clock breaker saga queue domain)
    add_test(NAME core_${case} COMMAND core_regression ${case})
  endforeach()
  add_executable(store_regression tests/store_tests.cpp)
  target_link_libraries(store_regression PRIVATE harbor_store)
  add_test(NAME store_transactions COMMAND store_regression)
  foreach(case happy lost_reply restart worker_restart partial invalid conflict overload crash_rollback)
    add_test(NAME integration_${case} COMMAND ${Python3_EXECUTABLE}
      ${CMAKE_CURRENT_SOURCE_DIR}/tests/integration.py
      --bin $<TARGET_FILE_DIR:harbor_gateway> --case ${case})
    set_tests_properties(integration_${case} PROPERTIES TIMEOUT 30)
  endforeach()
endif()
set(CPACK_PACKAGE_NAME "harbor-dispatch-lab")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_GENERATOR "TGZ")
include(CPack)
