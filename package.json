{
  "name": "design-patterns-study-studio",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "content:build": "node scripts/authoring-bridge.mjs",
    "test:browser": "node scripts/modular-browser-test.mjs",
    "preview:images": "node scripts/visual_check.mjs",
    "test:systems": "node scripts/systems_browser_test.mjs",
    "test:teaching": "node scripts/teaching_browser_test.mjs",
    "test:workshops": "python3 scripts/test_workshops.py",
    "test:systems-labs": "python3 scripts/test_systems_labs.py",
    "test:systems-depth": "node scripts/systems_depth_browser_test.mjs",
    "test:series": "node scripts/series_browser_test.mjs",
    "test:series-code": "python3 scripts/check_cpp_series_code.py",
    "test:series-advanced": "node scripts/series_advanced_browser_test.mjs",
    "test:book-menus": "node scripts/book_dropdown_browser_test.mjs",
    "coding:build": "node scripts/authoring-bridge.mjs --coding",
    "test:coding": "node scripts/test_coding_questions.mjs",
    "test:coding-browser": "node scripts/coding_browser_test.mjs",
    "test:coding-state": "node scripts/coding_state_browser_test.mjs",
    "test:book-one-worked": "node scripts/test_book_one_worked.mjs",
    "test:book-one-browser": "node scripts/book_one_browser_test.mjs",
    "test:book-two-worked": "node scripts/test_book_two_worked.mjs",
    "test:book-two-browser": "node scripts/book_two_browser_test.mjs",
    "test:book-three": "node scripts/book_three_companion_verify.mjs",
    "test:book-three-browser": "node scripts/book_three_browser_test.mjs",
    "package:book-three": "python3 scripts/package_book_three.py",
    "build:offline": "node scripts/build-offline.mjs",
    "content:legacy": "node scripts/materialize-legacy.mjs",
    "test:modular-browser": "node scripts/modular-browser-test.mjs",
    "validate": "node scripts/validate-build.mjs",
    "test:legacy-browser": "node scripts/browser_test.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@viz-js/viz": "3.25.0",
    "playwright": "1.62.1"
  },
  "description": "Modular, lossless Programming Studio for GitHub Pages with chapter lazy loading"
}
