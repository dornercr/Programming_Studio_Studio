{
  "name": "design-patterns-study-studio",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "content:build": "python3 scripts/make_content.py && node scripts/render_diagrams.mjs && node scripts/render_systems_diagrams.mjs",
    "test:browser": "node scripts/browser_test.mjs",
    "preview:images": "node scripts/visual_check.mjs",
    "test:systems": "node scripts/systems_browser_test.mjs",
    "test:teaching": "node scripts/teaching_browser_test.mjs",
    "test:workshops": "python3 scripts/test_workshops.py",
    "test:systems-labs": "python3 scripts/test_systems_labs.py",
    "test:systems-depth": "node scripts/systems_depth_browser_test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@viz-js/viz": "3.25.0",
    "playwright": "1.62.1"
  },
  "description": "Offline Design Patterns in C++ study companion using the supplied Tailwind Study Studio template"
}
