  async function slidesImport(file){
    if(!file)return;
    try{
      if(file.size>8*1024*1024)throw Error('The lecture backup is too large.');
      const data=JSON.parse(await file.text()),deck=slidesDeck();
      if(data.schemaVersion!==1||data.courseId!==deck.courseId||String(data.chapter)!==String(deck.chapter)||!isObject(data.work))throw Error('Open the matching course and chapter before importing this lecture backup.');
      const clean={index:Math.max(0,Math.min(Number(data.work.index)||0,deck.slides.length-1)),ratio:Math.max(35,Math.min(70,Number(data.work.ratio)||56)),drafts:{}};
      for(const slide of deck.slides){const d=data.work.drafts?.[slide.id];if(!slide.code||!isObject(d))continue;clean.drafts[slide.id]={code:typeof d.code==='string'?d.code.slice(0,60000):slide.code.text,input:typeof d.input==='string'?d.input.slice(0,20000):'',standard:d.standard==='c++17'?'c++17':'c++20',variant:slide.code.variants?.some(v=>v.id===d.variant)?d.variant:'original'};}
      slidesStop();slidesSaved[slidesKey()]=clean;slidesSave();renderSlidesWorkspace();if(Library)writeRoute();toast('Lecture work restored.');
    }catch(error){toast('Import failed: '+error.message);}
  }
  function slidesSetRatio(value){slidesState().ratio=Math.max(35,Math.min(70,value));$('#slides-room')?.style.setProperty('--slides-ratio',slidesRatio()+'%');$('#slides-splitter')?.setAttribute('aria-valuenow',String(Math.round(slidesRatio())));slidesSave();}
