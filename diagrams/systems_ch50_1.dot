digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"input" [label=<<TABLE BORDER="1" WIDTH="315" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="315" BGCOLOR="#eee9fb"><B>Establish the starting state</B></TD></TR><TR><TD WIDTH="315" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Inputs or state for this execution.<BR ALIGN="LEFT"/>const auto order = [](int from, int to) {</FONT></TD></TR></TABLE>>];
"mechanism" [label=<<TABLE BORDER="1" WIDTH="287" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="287" BGCOLOR="#eee9fb"><B>Use a shared lock order</B></TD></TR><TR><TD WIDTH="287" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Focus: follow the operation below.<BR ALIGN="LEFT"/>if (from &gt; to) std::swap(from, to);<BR ALIGN="LEFT"/>return std::pair&lt;int, int&gt;{from, to};</FONT></TD></TR></TABLE>>];
"observe" [label=<<TABLE BORDER="1" WIDTH="434" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="434" BGCOLOR="#eee9fb"><B>Observe the promised result</B></TD></TR><TR><TD WIDTH="434" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Check the result; retain the exact output.<BR ALIGN="LEFT"/>std::cout &lt;&lt; forward.first &lt;&lt; ',' &lt;&lt; forward.second &lt;&lt; ' '<BR ALIGN="LEFT"/>&lt;&lt; reverse.first &lt;&lt; ',' &lt;&lt; reverse.second &lt;&lt; '\n';</FONT></TD></TR></TABLE>>];
"input" -> "mechanism" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">Execute the selected<BR/>operation</TD></TR></TABLE>>];
"mechanism" -> "observe" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="130" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="130">Observe after the<BR/>operation</TD></TR></TABLE>>];
}