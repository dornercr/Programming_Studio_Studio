digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"A" [label=<<TABLE BORDER="1" WIDTH="280" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="280" BGCOLOR="#eee9fb"><B>Proxy: access gate</B></TD></TR><TR><TD WIDTH="280" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if (!allowed_) {<BR ALIGN="LEFT"/>// Failure exits before either path.</FONT></TD></TR></TABLE>>];
"C" [label=<<TABLE BORDER="1" WIDTH="231" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="231" BGCOLOR="#eee9fb"><B>Proxy: cached result</B></TD></TR><TR><TD WIDTH="231" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if (cached_) return *cached_;</FONT></TD></TR></TABLE>>];
"R" [label=<<TABLE BORDER="1" WIDTH="273" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="273" BGCOLOR="#eee9fb"><B>Real Subject: RealHours</B></TD></TR><TR><TD WIDTH="273" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if (!real_) {<BR ALIGN="LEFT"/>// Create once on a permitted miss.</FONT></TD></TR></TABLE>>];
"F" [label=<<TABLE BORDER="1" WIDTH="243" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="243" BGCOLOR="#eee9fb"><B>Proxy: delegate and cache</B></TD></TR><TR><TD WIDTH="243" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">cached_ = real_-&gt;opening();<BR ALIGN="LEFT"/>return *cached_;</FONT></TD></TR></TABLE>>];
"A" -> "C" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="62" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="62">allowed</TD></TR></TABLE>>];
"C" -> "R" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="89" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="89">cache empty</TD></TR></TABLE>>];
"R" -> "F" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="164" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="164">real service available</TD></TR></TABLE>>];
}