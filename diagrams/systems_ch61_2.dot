digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"pipeline" [label=<<TABLE BORDER="1" WIDTH="434" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="434" BGCOLOR="#eee9fb"><B>pipeline function</B></TD></TR><TR><TD WIDTH="434" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Build shared state before workers start.<BR ALIGN="LEFT"/>WorkQueue queue(2);<BR ALIGN="LEFT"/>std::vector&lt;std::optional&lt;Result&gt;&gt; results(inputs.size());</FONT></TD></TR></TABLE>>];
"queue" [label=<<TABLE BORDER="1" WIDTH="217" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="217" BGCOLOR="#eee9fb"><B>WorkQueue</B></TD></TR><TR><TD WIDTH="217" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Own queued Work objects.<BR ALIGN="LEFT"/>std::deque&lt;Work&gt; work_;</FONT></TD></TR></TABLE>>];
"work" [label=<<TABLE BORDER="1" WIDTH="406" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="406" BGCOLOR="#eee9fb"><B>Work</B></TD></TR><TR><TD WIDTH="406" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Each job owns its byte string.<BR ALIGN="LEFT"/>struct Work { std::size_t index; std::string bytes; };</FONT></TD></TR></TABLE>>];
"results" [label=<<TABLE BORDER="1" WIDTH="434" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="434" BGCOLOR="#eee9fb"><B>Indexed result slots</B></TD></TR><TR><TD WIDTH="434" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// One writer per preallocated slot.<BR ALIGN="LEFT"/>std::vector&lt;std::optional&lt;Result&gt;&gt; results(inputs.size());</FONT></TD></TR></TABLE>>];
"pipeline" -> "queue" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">constructs, pushes,<BR/>closes</TD></TR></TABLE>>];
"queue" -> "work" [dir=both, arrowtail=diamond, arrowhead=none,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="137" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="137">0 to 2 queued jobs</TD></TR></TABLE>>];
"pipeline" -> "results" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">allocates before<BR/>launch; returns after<BR/>join</TD></TR></TABLE>>];
"work" -> "results" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="171" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="171">worker writes result at<BR/>work.index</TD></TR></TABLE>>];
}