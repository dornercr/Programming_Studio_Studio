digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"input" [label=<<TABLE BORDER="1" WIDTH="294" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="294" BGCOLOR="#eee9fb"><B>Establish the starting state</B></TD></TR><TR><TD WIDTH="294" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Inputs or state for this execution.<BR ALIGN="LEFT"/>std::string backing = &quot;cat&quot;;</FONT></TD></TR></TABLE>>];
"mechanism" [label=<<TABLE BORDER="1" WIDTH="304" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="304" BGCOLOR="#eee9fb"><B>Private and shared mappings have<BR/>different write effects</B></TD></TR><TR><TD WIDTH="304" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Focus: follow the operation below.<BR ALIGN="LEFT"/>auto private_view = backing;<BR ALIGN="LEFT"/>auto&amp; shared_view = backing;<BR ALIGN="LEFT"/>private_view[0] = 'b';<BR ALIGN="LEFT"/>shared_view[2] = 'r';</FONT></TD></TR></TABLE>>];
"observe" [label=<<TABLE BORDER="1" WIDTH="392" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="392" BGCOLOR="#eee9fb"><B>Observe the promised result</B></TD></TR><TR><TD WIDTH="392" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">// Check the result; retain the exact output.<BR ALIGN="LEFT"/>std::cout &lt;&lt; backing &lt;&lt; ' ' &lt;&lt; private_view &lt;&lt; '\n';</FONT></TD></TR></TABLE>>];
"input" -> "mechanism" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">Execute the selected<BR/>operation</TD></TR></TABLE>>];
"mechanism" -> "observe" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="130" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="130">Observe after the<BR/>operation</TD></TR></TABLE>>];
}