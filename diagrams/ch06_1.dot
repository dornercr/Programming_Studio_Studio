digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"S" [label=<<TABLE BORDER="1" WIDTH="259" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="259" BGCOLOR="#eee9fb"><B>Target: Scale</B></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">virtual double grams() const = 0;</FONT></TD></TR></TABLE>>];
"A" [label=<<TABLE BORDER="1" WIDTH="217" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="217" BGCOLOR="#eee9fb"><B>Adapter: ScaleAdapter</B></TD></TR><TR><TD WIDTH="217" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">const LegacyScale&amp; device_;<BR ALIGN="LEFT"/>return raw / 1000.0;</FONT></TD></TR></TABLE>>];
"L" [label=<<TABLE BORDER="1" WIDTH="301" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="301" BGCOLOR="#eee9fb"><B>Adaptee: LegacyScale</B></TD></TR><TR><TD WIDTH="301" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">int milligrams() const { return raw_; }</FONT></TD></TR></TABLE>>];
"C" [label=<<TABLE BORDER="1" WIDTH="224" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="224" BGCOLOR="#eee9fb"><B>Client: light_enough</B></TD></TR><TR><TD WIDTH="224" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return scale.grams() &lt;= 2.0;</FONT></TD></TR></TABLE>>];
"A" -> "S" [arrowhead=empty,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="96" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="96">is usable as</TD></TR></TABLE>>];
"A" -> "L" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="110" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="110">borrows; calls<BR/>milligrams</TD></TR></TABLE>>];
"C" -> "S" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="171" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="171">requires grams contract</TD></TR></TABLE>>];
