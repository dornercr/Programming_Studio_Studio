digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"F" [label=<<TABLE BORDER="1" WIDTH="190" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="190" BGCOLOR="#eee9fb"><B>Abstract factory<BR/>CodecFactory</B></TD></TR><TR><TD WIDTH="190" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">encoder() const = 0;<BR ALIGN="LEFT"/>decoder() const = 0;<BR ALIGN="LEFT"/>// One selected family.</FONT></TD></TR></TABLE>>];
"C" [label=<<TABLE BORDER="1" WIDTH="259" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="259" BGCOLOR="#eee9fb"><B>Client<BR/>round_trip</B></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">auto encoder = factory.encoder();<BR ALIGN="LEFT"/>auto decoder = factory.decoder();</FONT></TD></TR></TABLE>>];
"E" [label=<<TABLE BORDER="1" WIDTH="231" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="231" BGCOLOR="#eee9fb"><B>Product A<BR/>Encoder</B></TD></TR><TR><TD WIDTH="231" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">virtual ~Encoder() = default;<BR ALIGN="LEFT"/>// Write one valid digit.</FONT></TD></TR></TABLE>>];
"D" [label=<<TABLE BORDER="1" WIDTH="231" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="231" BGCOLOR="#eee9fb"><B>Product B<BR/>Decoder</B></TD></TR><TR><TD WIDTH="231" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">virtual ~Decoder() = default;<BR ALIGN="LEFT"/>// Read the matching format.</FONT></TD></TR></TABLE>>];
"P" [label=<<TABLE BORDER="1" WIDTH="336" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="336" BGCOLOR="#eee9fb"><B>Concrete factory<BR/>FramedFactory</B></TD></TR><TR><TD WIDTH="336" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return std::make_unique&lt;FramedEncoder&gt;();<BR ALIGN="LEFT"/>// Other factory method returns the decoder.<BR ALIGN="LEFT"/>return std::make_unique&lt;FramedDecoder&gt;();<BR ALIGN="LEFT"/>// Create FramedEncoder and Decoder.</FONT></TD></TR></TABLE>>];
"P" -> "F" [arrowhead=empty,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="130" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="130">implements family<BR/>creation</TD></TR></TABLE>>];
"C" -> "F" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="116" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="116">borrows factory</TD></TR></TABLE>>];
"F" -> "E" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="110" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="110">creates writer</TD></TR></TABLE>>];
"F" -> "D" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="110" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="110">creates reader</TD></TR></TABLE>>];
}