digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"owner" [label=<<TABLE BORDER="1" WIDTH="371" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="371" BGCOLOR="#eee9fb"><B>main owns both arrays</B></TD></TR><TR><TD WIDTH="371" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::array&lt;int,6&gt; input{1,2,3,4,5,6}, squared{};<BR ALIGN="LEFT"/>// Storage remains alive until both tasks finish.</FONT></TD></TR></TABLE>>];
"left" [label=<<TABLE BORDER="1" WIDTH="420" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="420" BGCOLOR="#eee9fb"><B>First task: indices 0, 1, 2</B></TD></TR><TR><TD WIDTH="420" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">auto first=std::async(std::launch::async,transform,0,3);<BR ALIGN="LEFT"/>// This task writes only its own slice.</FONT></TD></TR></TABLE>>];
"right" [label=<<TABLE BORDER="1" WIDTH="427" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="427" BGCOLOR="#eee9fb"><B>Second task: indices 3, 4, 5</B></TD></TR><TR><TD WIDTH="427" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">auto second=std::async(std::launch::async,transform,3,6);<BR ALIGN="LEFT"/>// Its slice does not overlap the first.</FONT></TD></TR></TABLE>>];
"join" [label=<<TABLE BORDER="1" WIDTH="378" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="378" BGCOLOR="#eee9fb"><B>Wait, then reduce</B></TD></TR><TR><TD WIDTH="378" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">first.get(); second.get();<BR ALIGN="LEFT"/>std::accumulate(squared.begin(),squared.end(),0)<BR ALIGN="LEFT"/>// Reduction reads only after both tasks complete.</FONT></TD></TR></TABLE>>];
"owner" -> "left" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">borrow arrays through<BR/>the lambda</TD></TR></TABLE>>];
"owner" -> "right" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">borrow the same live<BR/>storage</TD></TR></TABLE>>];
"left" -> "join" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">first.get() completes</TD></TR></TABLE>>];
"right" -> "join" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="164" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="164">second.get() completes</TD></TR></TABLE>>];
}