digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"P" [label=<<TABLE BORDER="1" WIDTH="252" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="252" BGCOLOR="#eee9fb"><B>Factory: StylePool</B></TD></TR><TR><TD WIDTH="252" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::map&lt;Key, StylePtr&gt; styles_;</FONT></TD></TR></TABLE>>];
"S" [label=<<TABLE BORDER="1" WIDTH="218" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="218" BGCOLOR="#eee9fb"><B>Flyweight: const Style</B></TD></TR><TR><TD WIDTH="218" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::string name;<BR ALIGN="LEFT"/>int size;</FONT></TD></TR></TABLE>>];
"L" [label=<<TABLE BORDER="1" WIDTH="190" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="190" BGCOLOR="#eee9fb"><B>Context: left Mark</B></TD></TR><TR><TD WIDTH="190" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">StylePtr style_;<BR ALIGN="LEFT"/>int x_;</FONT></TD></TR></TABLE>>];
"R" [label=<<TABLE BORDER="1" WIDTH="231" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="231" BGCOLOR="#eee9fb"><B>Context: right Mark</B></TD></TR><TR><TD WIDTH="231" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">Mark right(same, 8);<BR ALIGN="LEFT"/>// Shares style; keeps x = 8.</FONT></TD></TR></TABLE>>];
"P" -> "S" [style=dashed, arrowhead=vee, color="#267b66",label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">shared owner in map</TD></TR></TABLE>>];
"L" -> "S" [style=dashed, arrowhead=vee, color="#267b66",label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">shared owner; x = 3<BR/>local</TD></TR></TABLE>>];
"R" -> "S" [style=dashed, arrowhead=vee, color="#267b66",label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">shared owner; x = 8<BR/>local</TD></TR></TABLE>>];
}