digraph G { graph [rankdir=LR, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"I" [label=<<TABLE BORDER="1" WIDTH="217" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="217" BGCOLOR="#eee9fb"><B>Idle</B></TD></TR><TR><TD WIDTH="217" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">State state_ = State::idle;<BR ALIGN="LEFT"/>// New monitor starts here.</FONT></TD></TR></TABLE>>];
"R" [label=<<TABLE BORDER="1" WIDTH="231" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="231" BGCOLOR="#eee9fb"><B>Running</B></TD></TR><TR><TD WIDTH="231" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">state_ = State::running;<BR ALIGN="LEFT"/>// Batch intake is permitted.</FONT></TD></TR></TABLE>>];
"P" [label=<<TABLE BORDER="1" WIDTH="259" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="259" BGCOLOR="#eee9fb"><B>Paused</B></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">state_ = State::paused;<BR ALIGN="LEFT"/>// Rule replacement is permitted.</FONT></TD></TR></TABLE>>];
"S" [label=<<TABLE BORDER="1" WIDTH="231" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="231" BGCOLOR="#eee9fb"><B>Stopped</B></TD></TR><TR><TD WIDTH="231" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">state_ = State::stopped;<BR ALIGN="LEFT"/>// No restart on this object.</FONT></TD></TR></TABLE>>];
"I" -> "R" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="62" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="62">start()</TD></TR></TABLE>>];
