"M" [label=<<TABLE BORDER="1" WIDTH="259" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="259" BGCOLOR="#eee9fb"><B>Monitor</B></TD></TR><TR><TD WIDTH="259" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::unique_ptr&lt;AlertRule&gt; rule_;<BR ALIGN="LEFT"/>std::vector&lt;Record&gt; records_;<BR ALIGN="LEFT"/>// Owns both lifetimes.</FONT></TD></TR></TABLE>>];
"R" [label=<<TABLE BORDER="1" WIDTH="266" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="266" BGCOLOR="#eee9fb"><B>AlertRule</B></TD></TR><TR><TD WIDTH="266" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">virtual ~AlertRule() = default;<BR ALIGN="LEFT"/>// Base supports safe destruction.</FONT></TD></TR></TABLE>>];
