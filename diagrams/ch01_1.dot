digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"J" [label=<<TABLE BORDER="1" WIDTH="245" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="245" BGCOLOR="#eee9fb"><B>Creator<BR/>ArchiveJob</B></TD></TR><TR><TD WIDTH="245" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">auto record = make();<BR ALIGN="LEFT"/>// Workflow requests a product.</FONT></TD></TR></TABLE>>];
