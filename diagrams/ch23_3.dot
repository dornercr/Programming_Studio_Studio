digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"M" [label=<<TABLE BORDER="1" WIDTH="252" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="252" BGCOLOR="#eee9fb"><B>Monitor::ingest</B></TD></TR><TR><TD WIDTH="252" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">auto staged = records_;<BR ALIGN="LEFT"/>// Live history stays unchanged.</FONT></TD></TR></TABLE>>];
"A" [label=<<TABLE BORDER="1" WIDTH="252" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="252" BGCOLOR="#eee9fb"><B>SampleAdapter::convert</B></TD></TR><TR><TD WIDTH="252" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return {raw.id, c};<BR ALIGN="LEFT"/>// Returns one normalized value.</FONT></TD></TR></TABLE>>];
"R" [label=<<TABLE BORDER="1" WIDTH="273" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="273" BGCOLOR="#eee9fb"><B>AlertRule::alert</B></TD></TR><TR><TD WIDTH="273" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return s.celsius &gt;= limit_;<BR ALIGN="LEFT"/>// Concrete AtLeast implementation.</FONT></TD></TR></TABLE>>];
"T" [label=<<TABLE BORDER="1" WIDTH="252" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="252" BGCOLOR="#eee9fb"><B>Staged vector</B></TD></TR><TR><TD WIDTH="252" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">staged.push_back({s, hot});<BR ALIGN="LEFT"/>// Receives the proposed record.</FONT></TD></TR></TABLE>>];
"M" -> "A" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="110" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="110">1 convert(raw)</TD></TR></TABLE>>];
"M" -> "R" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">2 alert(s), after id<BR/>check</TD></TR></TABLE>>];
"M" -> "T" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">3 push_back({s, hot})</TD></TR></TABLE>>];
}