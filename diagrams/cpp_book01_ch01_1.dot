digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"readings" [label=<<TABLE BORDER="1" WIDTH="420" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="420" BGCOLOR="#eee9fb"><B>Own three readings</B></TD></TR><TR><TD WIDTH="420" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::vector&lt;Reading&gt; r{{3, 18.2}, {1, 20.1}, {2, 19.4}};<BR ALIGN="LEFT"/>// Each element keeps its id and value together.</FONT></TD></TR></TABLE>>];
"compare" [label=<<TABLE BORDER="1" WIDTH="301" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="301" BGCOLOR="#eee9fb"><B>Compare identifiers</B></TD></TR><TR><TD WIDTH="301" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return a.id &lt; b.id;<BR ALIGN="LEFT"/>// The comparator chooses the ordering.</FONT></TD></TR></TABLE>>];
"sort" [label=<<TABLE BORDER="1" WIDTH="329" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="329" BGCOLOR="#eee9fb"><B>Reorder the vector</B></TD></TR><TR><TD WIDTH="329" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">std::sort(r.begin(), r.end(),<BR ALIGN="LEFT"/>    [](const Reading&amp; a, const Reading&amp; b){<BR ALIGN="LEFT"/>        return a.id &lt; b.id;<BR ALIGN="LEFT"/>    });<BR ALIGN="LEFT"/>// Same call, formatted across lines.</FONT></TD></TR></TABLE>>];
"print" [label=<<TABLE BORDER="1" WIDTH="364" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="364" BGCOLOR="#eee9fb"><B>Visit the ordered values</B></TD></TR><TR><TD WIDTH="364" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">for (const auto&amp; x : r)<BR ALIGN="LEFT"/>    std::cout &lt;&lt; x.id &lt;&lt; ':' &lt;&lt; x.value &lt;&lt; '\n';<BR ALIGN="LEFT"/>// Read each element without copying it.</FONT></TD></TR></TABLE>>];
"readings" -> "sort" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="150" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="150">input order: 3, 1, 2</TD></TR></TABLE>>];
"compare" -> "sort" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="123" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="123">comparison rule<BR/>supplied to sort</TD></TR></TABLE>>];
"sort" -> "print" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">output order: 1, 2, 3</TD></TR></TABLE>>];
}