digraph G { graph [rankdir=TB, bgcolor="#fcfbff", pad="0.3", nodesep="0.4", ranksep="0.7"]; node [shape=plain]; edge [fontname="Arial", fontsize=13, color="#7955ac", penwidth=1.8];
"caller" [label=<<TABLE WIDTH="334" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>Caller receives the owner</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">return result;<BR ALIGN="LEFT"/>// Sole ownership moves to the caller.</FONT></TD></TR></TABLE>>];
"owner" [label=<<TABLE WIDTH="390" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>unique_ptr&lt;int[]&gt; owner</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">auto result = std::make_unique&lt;int[]&gt;(count);<BR ALIGN="LEFT"/>// Its destructor releases the array.</FONT></TD></TR></TABLE>>];
"elements" [label=<<TABLE WIDTH="638" BORDER="1" COLOR="#b9a3d2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#eee4f7"><FONT FACE="Arial" POINT-SIZE="16"><B>count live array elements</B></FONT></TD></TR><TR><TD BGCOLOR="#ffffff" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="13">for (std::size_t i = 0; i &lt; count; ++i) result[i] = static_cast&lt;int&gt;(i) + 1;<BR ALIGN="LEFT"/>// Indices must stay below count.</FONT></TD></TR></TABLE>>];
"owner" -> "elements" [dir=both,arrowtail=diamond,arrowhead=none,label="sole release responsibility; delete[]"];
"owner" -> "caller" [arrowhead=vee,label="return transfers ownership"];
}