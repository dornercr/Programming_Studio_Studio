"E" [label=<<TABLE BORDER="1" WIDTH="245" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="245" BGCOLOR="#eee9fb"><B>Strategy: Estimate</B></TD></TR><TR><TD WIDTH="245" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">virtual ~Estimate() = default;<BR ALIGN="LEFT"/>// Shared calculation contract.</FONT></TD></TR></TABLE>>];
