digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"V" [label=<<TABLE BORDER="1" WIDTH="308" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="308" BGCOLOR="#eee9fb"><B>Router: route</B></TD></TR><TR><TD WIDTH="308" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if (job.pages &lt; 1 || job.pages &gt; 1000) {<BR ALIGN="LEFT"/>return &quot;rejected&quot;;<BR ALIGN="LEFT"/>}<BR ALIGN="LEFT"/>// Reject before trying handlers.</FONT></TD></TR></TABLE>>];
"L" [label=<<TABLE BORDER="1" WIDTH="192" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="192" BGCOLOR="#eee9fb"><B>Handler: label_rule</B></TD></TR><TR><TD WIDTH="192" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return &quot;label desk&quot;;</FONT></TD></TR></TABLE>>];
"G" [label=<<TABLE BORDER="1" WIDTH="209" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="209" BGCOLOR="#eee9fb"><B>Handler: general_rule</B></TD></TR><TR><TD WIDTH="209" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return &quot;general desk&quot;;</FONT></TD></TR></TABLE>>];
"U" [label=<<TABLE BORDER="1" WIDTH="190" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="190" BGCOLOR="#eee9fb"><B>Chain exhausted</B></TD></TR><TR><TD WIDTH="190" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return &quot;unhandled&quot;;</FONT></TD></TR></TABLE>>];
"V" -> "L" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="89" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="89">valid pages</TD></TR></TABLE>>];
"L" -> "G" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">label_rule declines</TD></TR></TABLE>>];
"G" -> "U" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">general_rule declines</TD></TR></TABLE>>];
}