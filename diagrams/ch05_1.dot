digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"S" [label=<<TABLE BORDER="1" WIDTH="273" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="273" BGCOLOR="#eee9fb"><B>Singleton instance<BR/>TicketDispenser</B></TD></TR><TR><TD WIDTH="273" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">static TicketDispenser dispenser;<BR ALIGN="LEFT"/>// Own the one local static object.</FONT></TD></TR></TABLE>>];
"A" [label=<<TABLE BORDER="1" WIDTH="322" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="322" BGCOLOR="#eee9fb"><B>Client reference<BR/>first</B></TD></TR><TR><TD WIDTH="322" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">auto&amp; first = TicketDispenser::instance();<BR ALIGN="LEFT"/>// Borrow; never delete.</FONT></TD></TR></TABLE>>];
"B" [label=<<TABLE BORDER="1" WIDTH="329" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="329" BGCOLOR="#eee9fb"><B>Client reference<BR/>second</B></TD></TR><TR><TD WIDTH="329" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">auto&amp; second = TicketDispenser::instance();<BR ALIGN="LEFT"/>// Same borrowed object.</FONT></TD></TR></TABLE>>];
"T" [label=<<TABLE BORDER="1" WIDTH="273" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="273" BGCOLOR="#eee9fb"><B>Service operation<BR/>TicketDispenser::take</B></TD></TR><TR><TD WIDTH="273" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">return next_++;<BR ALIGN="LEFT"/>// Guard check and update together.</FONT></TD></TR></TABLE>>];
"A" -> "S" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">borrows same instance</TD></TR></TABLE>>];
"B" -> "S" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">borrows same instance</TD></TR></TABLE>>];
"S" -> "T" [style=dashed, arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="171" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="171">offers locked operation</TD></TR></TABLE>>];
}