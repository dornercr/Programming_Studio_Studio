digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch17/main.cpp:56-61<BR ALIGN="LEFT"/>    Selection selection;<BR ALIGN="LEFT"/>    History history(selection);<BR ALIGN="LEFT"/>    check(!history.undo());<BR ALIGN="LEFT"/>    selection.set(2, 5);<BR ALIGN="LEFT"/>    const auto saved = selection.save();<BR ALIGN="LEFT"/>    history.remember();</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Selection creates a private nested Snapshot<BR ALIGN="LEFT"/>containing copied integers. History owns<BR ALIGN="LEFT"/>snapshots by value and borrows the<BR ALIGN="LEFT"/>selection. Restoration leaves the snapshot<BR ALIGN="LEFT"/>reusable and history consumes a record only<BR ALIGN="LEFT"/>after restore.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Every Selection pair is valid before and<BR ALIGN="LEFT"/>after public operations.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Snapshot stores references to low_ and high_<BR ALIGN="LEFT"/>instead of copied values. After setting<BR ALIGN="LEFT"/>[20,40], the alleged old snapshot also reads<BR ALIGN="LEFT"/>[20,40]. It observes current storage rather<BR ALIGN="LEFT"/>than retaining the old state.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch17/main.cpp:56-61<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch17/main.cpp:62-67<BR ALIGN="LEFT"/>    selection.set(20, 40);<BR ALIGN="LEFT"/>    check(history.undo());<BR ALIGN="LEFT"/>    check(selection.low() == 2 &amp;&amp; selection.high() == 5);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;restored: &quot; &lt;&lt; selection.low() &lt;&lt; ':'<BR ALIGN="LEFT"/>              &lt;&lt; selection.high() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    check(!history.undo());</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Selection creates a private nested Snapshot<BR ALIGN="LEFT"/>containing copied integers. History owns<BR ALIGN="LEFT"/>snapshots by value and borrows the<BR ALIGN="LEFT"/>selection. Restoration leaves the snapshot<BR ALIGN="LEFT"/>reusable and history consumes a record only<BR ALIGN="LEFT"/>after restore.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>A saved snapshot is unaffected by later<BR ALIGN="LEFT"/>changes to its source.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Assign low_ before validating high and low<BR ALIGN="LEFT"/>together. A rejected set(9,3) may leave the<BR ALIGN="LEFT"/>interval partially changed and invalid.<BR ALIGN="LEFT"/>Throwing does not undo earlier assignments<BR ALIGN="LEFT"/>automatically.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch17/main.cpp:62-67<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch17/main.cpp:68-73<BR ALIGN="LEFT"/>    bool rejected = false;<BR ALIGN="LEFT"/>    try { selection.set(9, 3); }<BR ALIGN="LEFT"/>    catch (const std::out_of_range&amp;) { rejected = true; }<BR ALIGN="LEFT"/>    check(rejected &amp;&amp; selection.low() == 2 &amp;&amp; selection.high() == 5);<BR ALIGN="LEFT"/>    selection.set(0, 100);<BR ALIGN="LEFT"/>    selection.restore(saved);</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Selection creates a private nested Snapshot<BR ALIGN="LEFT"/>containing copied integers. History owns<BR ALIGN="LEFT"/>snapshots by value and borrows the<BR ALIGN="LEFT"/>selection. Restoration leaves the snapshot<BR ALIGN="LEFT"/>reusable and history consumes a record only<BR ALIGN="LEFT"/>after restore.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>History must not outlive the Selection it<BR ALIGN="LEFT"/>borrows.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Snapshot stores references to low_ and high_<BR ALIGN="LEFT"/>instead of copied values. After setting<BR ALIGN="LEFT"/>[20,40], the alleged old snapshot also reads<BR ALIGN="LEFT"/>[20,40]. It observes current storage rather<BR ALIGN="LEFT"/>than retaining the old state.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch17/main.cpp:68-73<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}