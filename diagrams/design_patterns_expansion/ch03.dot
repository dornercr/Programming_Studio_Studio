digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch03/main.cpp:63-68<BR ALIGN="LEFT"/>    const Plan intro = introduction();<BR ALIGN="LEFT"/>    check(intro.title() == &quot;Introduction&quot; &amp;&amp; intro.total() == 50);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; intro.title() &lt;&lt; &quot;: &quot; &lt;&lt; intro.total() &lt;&lt; &quot; minutes\n&quot;;<BR ALIGN="LEFT"/>    PlanBuilder builder;<BR ALIGN="LEFT"/>    builder.named(&quot;Practice&quot;).add(30).add(30);<BR ALIGN="LEFT"/>    const Plan first = builder.build();</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>PlanBuilder stores draft values and alone<BR ALIGN="LEFT"/>can call the private Plan constructor after<BR ALIGN="LEFT"/>validation. Products own copied data and<BR ALIGN="LEFT"/>expose only read access, so partial setup<BR ALIGN="LEFT"/>cannot leak through the product API.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Every successfully built or copied Plan has<BR ALIGN="LEFT"/>a title, valid activity count, valid<BR ALIGN="LEFT"/>durations, and total at most 90.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Return a reference to builder-owned draft<BR ALIGN="LEFT"/>storage as the finished product. The<BR ALIGN="LEFT"/>60-minute first snapshot would change when a<BR ALIGN="LEFT"/>third 30-minute activity is added, or dangle<BR ALIGN="LEFT"/>when the builder dies. The apparent finished<BR ALIGN="LEFT"/>product does not own independent data.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch03/main.cpp:63-68<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch03/main.cpp:69-74<BR ALIGN="LEFT"/>    builder.add(30);<BR ALIGN="LEFT"/>    const Plan second = builder.build();<BR ALIGN="LEFT"/>    check(first.total() == 60 &amp;&amp; second.total() == 90);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;snapshots=&quot; &lt;&lt; first.total() &lt;&lt; ',' &lt;&lt; second.total() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    bool rejected = false;<BR ALIGN="LEFT"/>    try { PlanBuilder{}.build(); }</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>PlanBuilder stores draft values and alone<BR ALIGN="LEFT"/>can call the private Plan constructor after<BR ALIGN="LEFT"/>validation. Products own copied data and<BR ALIGN="LEFT"/>expose only read access, so partial setup<BR ALIGN="LEFT"/>cannot leak through the product API.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>The builder may be incomplete but never<BR ALIGN="LEFT"/>publishes that state as a Plan.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Validate each duration but never validate<BR ALIGN="LEFT"/>the total. A plan with {60,60} is published<BR ALIGN="LEFT"/>at 120 minutes. Per-item validity does not<BR ALIGN="LEFT"/>imply whole-product validity.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch03/main.cpp:69-74<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch03/main.cpp:75-80<BR ALIGN="LEFT"/>    catch (const std::logic_error&amp;) { rejected = true; }<BR ALIGN="LEFT"/>    check(rejected);<BR ALIGN="LEFT"/>    rejected = false;<BR ALIGN="LEFT"/>    try { builder.add(0); }<BR ALIGN="LEFT"/>    catch (const std::invalid_argument&amp;) { rejected = true; }<BR ALIGN="LEFT"/>    check(rejected &amp;&amp; builder.build().total() == 90);</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>PlanBuilder stores draft values and alone<BR ALIGN="LEFT"/>can call the private Plan constructor after<BR ALIGN="LEFT"/>validation. Products own copied data and<BR ALIGN="LEFT"/>expose only read access, so partial setup<BR ALIGN="LEFT"/>cannot leak through the product API.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Previously built snapshots are independent<BR ALIGN="LEFT"/>of later builder changes.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Return a reference to builder-owned draft<BR ALIGN="LEFT"/>storage as the finished product. The<BR ALIGN="LEFT"/>60-minute first snapshot would change when a<BR ALIGN="LEFT"/>third 30-minute activity is added, or dangle<BR ALIGN="LEFT"/>when the builder dies. The apparent finished<BR ALIGN="LEFT"/>product does not own independent data.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch03/main.cpp:75-80<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}