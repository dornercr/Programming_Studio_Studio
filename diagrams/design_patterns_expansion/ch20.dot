digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch20/main.cpp:60-65<BR ALIGN="LEFT"/>    const std::vector&lt;int&gt; data{1, 2, 9};<BR ALIGN="LEFT"/>    Monitor monitor(std::make_unique&lt;Average&gt;());<BR ALIGN="LEFT"/>    check(monitor.read(data) == 4);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;average=&quot; &lt;&lt; monitor.read(data) &lt;&lt; '\n';<BR ALIGN="LEFT"/>    monitor.select(std::make_unique&lt;Highest&gt;());<BR ALIGN="LEFT"/>    check(monitor.read(data) == 9);</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Monitor centralizes validation while<BR ALIGN="LEFT"/>Estimate isolates the changing calculation.<BR ALIGN="LEFT"/>Owning the selected rule avoids a<BR ALIGN="LEFT"/>caller-lifetime dependency and permits<BR ALIGN="LEFT"/>replacement after construction.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Every constructed Monitor owns a non-null<BR ALIGN="LEFT"/>strategy.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Assign a null handle before checking it. The<BR ALIGN="LEFT"/>next read attempts to call through a null<BR ALIGN="LEFT"/>pointer, producing undefined behavior. The<BR ALIGN="LEFT"/>object no longer meets its non-null<BR ALIGN="LEFT"/>invariant.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch20/main.cpp:60-65<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch20/main.cpp:66-71<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;highest=&quot; &lt;&lt; monitor.read(data) &lt;&lt; '\n';<BR ALIGN="LEFT"/>    check(monitor.read({0}) == 0);<BR ALIGN="LEFT"/>    check(monitor.read({1000}) == 1000);<BR ALIGN="LEFT"/>    bool rejected = false;<BR ALIGN="LEFT"/>    try { monitor.read({}); }<BR ALIGN="LEFT"/>    catch (const std::invalid_argument&amp;) { rejected = true; }</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Monitor centralizes validation while<BR ALIGN="LEFT"/>Estimate isolates the changing calculation.<BR ALIGN="LEFT"/>Owning the selected rule avoids a<BR ALIGN="LEFT"/>caller-lifetime dependency and permits<BR ALIGN="LEFT"/>replacement after construction.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Every strategy call receives a nonempty<BR ALIGN="LEFT"/>bounded batch.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Implement average as sum += sample /<BR ALIGN="LEFT"/>data.size(). For {1,2,9}, the result becomes<BR ALIGN="LEFT"/>0 + 0 + 3 = 3 instead of 4. Integer division<BR ALIGN="LEFT"/>discards each remainder before the additions<BR ALIGN="LEFT"/>can combine it.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch20/main.cpp:66-71<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch20/main.cpp:72-77<BR ALIGN="LEFT"/>    check(rejected);<BR ALIGN="LEFT"/>    rejected = false;<BR ALIGN="LEFT"/>    try { monitor.read({-1}); }<BR ALIGN="LEFT"/>    catch (const std::invalid_argument&amp;) { rejected = true; }<BR ALIGN="LEFT"/>    check(rejected);<BR ALIGN="LEFT"/>    rejected = false;</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Monitor centralizes validation while<BR ALIGN="LEFT"/>Estimate isolates the changing calculation.<BR ALIGN="LEFT"/>Owning the selected rule avoids a<BR ALIGN="LEFT"/>caller-lifetime dependency and permits<BR ALIGN="LEFT"/>replacement after construction.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>read does not change input; a rejected<BR ALIGN="LEFT"/>select leaves the old rule installed.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Assign a null handle before checking it. The<BR ALIGN="LEFT"/>next read attempts to call through a null<BR ALIGN="LEFT"/>pointer, producing undefined behavior. The<BR ALIGN="LEFT"/>object no longer meets its non-null<BR ALIGN="LEFT"/>invariant.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch20/main.cpp:72-77<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
