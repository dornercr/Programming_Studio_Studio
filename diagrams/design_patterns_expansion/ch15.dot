digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch15/main.cpp:57-62<BR ALIGN="LEFT"/>    Readings readings;<BR ALIGN="LEFT"/>    auto empty = readings.cursor();<BR ALIGN="LEFT"/>    check(empty.done());<BR ALIGN="LEFT"/>    bool end_rejected = false;<BR ALIGN="LEFT"/>    try { empty.read(); }<BR ALIGN="LEFT"/>    catch (const std::out_of_range&amp;) { end_rejected = true; }</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Cursor stores only a borrowed owner, saved<BR ALIGN="LEFT"/>version, and index. Readings keeps its<BR ALIGN="LEFT"/>representation private and refuses copying<BR ALIGN="LEFT"/>or moving that could complicate its<BR ALIGN="LEFT"/>identity. Values are copied out.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>The owner must remain alive and in place<BR ALIGN="LEFT"/>while a cursor is used.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Treat a bounds check as a complete validity<BR ALIGN="LEFT"/>check. An old cursor can continue after<BR ALIGN="LEFT"/>append even though the promised fixed view<BR ALIGN="LEFT"/>has ended. Its index may still be in bounds;<BR ALIGN="LEFT"/>validity also depends on collection<BR ALIGN="LEFT"/>generation.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch15/main.cpp:57-62<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch15/main.cpp:63-68<BR ALIGN="LEFT"/>    check(end_rejected);<BR ALIGN="LEFT"/>    readings.append(4);<BR ALIGN="LEFT"/>    readings.append(9);<BR ALIGN="LEFT"/>    auto cursor = readings.cursor();<BR ALIGN="LEFT"/>    auto independent = cursor;<BR ALIGN="LEFT"/>    check(cursor.read() == 4);</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Cursor stores only a borrowed owner, saved<BR ALIGN="LEFT"/>version, and index. Readings keeps its<BR ALIGN="LEFT"/>representation private and refuses copying<BR ALIGN="LEFT"/>or moving that could complicate its<BR ALIGN="LEFT"/>identity. Values are copied out.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>A live cursor index is at most the number of<BR ALIGN="LEFT"/>readings.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Keep a cursor after its owner leaves scope.<BR ALIGN="LEFT"/>Even done() accesses a dead object; the<BR ALIGN="LEFT"/>behavior is undefined. A borrowed reference<BR ALIGN="LEFT"/>does not own or extend the collection<BR ALIGN="LEFT"/>lifetime.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch15/main.cpp:63-68<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch15/main.cpp:69-74<BR ALIGN="LEFT"/>    cursor.next();<BR ALIGN="LEFT"/>    check(cursor.read() == 9 &amp;&amp; independent.read() == 4);<BR ALIGN="LEFT"/>    int total = 0;<BR ALIGN="LEFT"/>    for (auto scan = readings.cursor(); !scan.done(); scan.next()) {<BR ALIGN="LEFT"/>        total += scan.read();<BR ALIGN="LEFT"/>    }</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Cursor stores only a borrowed owner, saved<BR ALIGN="LEFT"/>version, and index. Readings keeps its<BR ALIGN="LEFT"/>representation private and refuses copying<BR ALIGN="LEFT"/>or moving that could complicate its<BR ALIGN="LEFT"/>identity. Values are copied out.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>A version mismatch is rejected before data<BR ALIGN="LEFT"/>access.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Treat a bounds check as a complete validity<BR ALIGN="LEFT"/>check. An old cursor can continue after<BR ALIGN="LEFT"/>append even though the promised fixed view<BR ALIGN="LEFT"/>has ended. Its index may still be in bounds;<BR ALIGN="LEFT"/>validity also depends on collection<BR ALIGN="LEFT"/>generation.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch15/main.cpp:69-74<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}