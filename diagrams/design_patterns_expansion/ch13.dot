digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch13/main.cpp:49-53<BR ALIGN="LEFT"/>    const std::vector&lt;Rule&gt; rules{label_rule, general_rule};<BR ALIGN="LEFT"/>    check(route({&quot;label&quot;, 2}, rules) == &quot;label desk&quot;);<BR ALIGN="LEFT"/>    check(route({&quot;report&quot;, 1000}, rules) == &quot;general desk&quot;);<BR ALIGN="LEFT"/>    check(route({&quot;archive&quot;, 1}, rules) == &quot;unhandled&quot;);<BR ALIGN="LEFT"/>    check(route({&quot;label&quot;, 0}, rules) == &quot;rejected&quot;);</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Store small function handlers in a vector<BR ALIGN="LEFT"/>and use an optional destination. The vector<BR ALIGN="LEFT"/>makes order visible; the optional result<BR ALIGN="LEFT"/>separates a decline from an accepted<BR ALIGN="LEFT"/>request. One route function owns the<BR ALIGN="LEFT"/>stopping rule.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>A valid job receives at most one<BR ALIGN="LEFT"/>destination.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Continue through the vector after finding a<BR ALIGN="LEFT"/>destination. A label job can finish as<BR ALIGN="LEFT"/>general desk instead of label desk. The two<BR ALIGN="LEFT"/>handlers overlap, so the last answer<BR ALIGN="LEFT"/>replaces the first.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch13/main.cpp:49-53<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch13/main.cpp:54-58<BR ALIGN="LEFT"/>    check(route({&quot;label&quot;, 1001}, rules) == &quot;rejected&quot;);<BR ALIGN="LEFT"/>    check(route({&quot;label&quot;, 1}, {}) == &quot;unhandled&quot;);<BR ALIGN="LEFT"/>    const std::vector&lt;Rule&gt; reverse{general_rule, label_rule};<BR ALIGN="LEFT"/>    check(route({&quot;label&quot;, 1}, reverse) == &quot;general desk&quot;);<BR ALIGN="LEFT"/>    for (const Job&amp; job : std::vector&lt;Job&gt;{</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Store small function handlers in a vector<BR ALIGN="LEFT"/>and use an optional destination. The vector<BR ALIGN="LEFT"/>makes order visible; the optional result<BR ALIGN="LEFT"/>separates a decline from an accepted<BR ALIGN="LEFT"/>request. One route function owns the<BR ALIGN="LEFT"/>stopping rule.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Every handler sees the same unchanged job.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Place the general handler before the label<BR ALIGN="LEFT"/>handler. Every supported label job selects<BR ALIGN="LEFT"/>general desk. The first willing handler wins<BR ALIGN="LEFT"/>even if a later one is more specific.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch13/main.cpp:54-58<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch13/main.cpp:59-61<BR ALIGN="LEFT"/>             {&quot;label&quot;, 2}, {&quot;report&quot;, 8}, {&quot;archive&quot;, 1}, {&quot;label&quot;, 0}}) {<BR ALIGN="LEFT"/>        std::cout &lt;&lt; route(job, rules) &lt;&lt; '\n';<BR ALIGN="LEFT"/>    }</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Store small function handlers in a vector<BR ALIGN="LEFT"/>and use an optional destination. The vector<BR ALIGN="LEFT"/>makes order visible; the optional result<BR ALIGN="LEFT"/>separates a decline from an accepted<BR ALIGN="LEFT"/>request. One route function owns the<BR ALIGN="LEFT"/>stopping rule.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Rejected counts never enter a handler.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Continue through the vector after finding a<BR ALIGN="LEFT"/>destination. A label job can finish as<BR ALIGN="LEFT"/>general desk instead of label desk. The two<BR ALIGN="LEFT"/>handlers overlap, so the last answer<BR ALIGN="LEFT"/>replaces the first.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch13/main.cpp:59-61<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
