digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch11/main.cpp:56-61<BR ALIGN="LEFT"/>    StylePool pool;<BR ALIGN="LEFT"/>    const auto first = pool.get(&quot;dot&quot;, 12);<BR ALIGN="LEFT"/>    const auto same = pool.get(&quot;dot&quot;, 12);<BR ALIGN="LEFT"/>    const auto large = pool.get(&quot;dot&quot;, 20);<BR ALIGN="LEFT"/>    check(first == same &amp;&amp; first != large);<BR ALIGN="LEFT"/>    check(pool.count() == 2);</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>A map interns immutable Style objects by a<BR ALIGN="LEFT"/>complete structured key. shared_ptr allows<BR ALIGN="LEFT"/>marks to retain styles after a pool is<BR ALIGN="LEFT"/>destroyed.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>One active pool returns the same object for<BR ALIGN="LEFT"/>the same key.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Use only name as the pool key. A request for<BR ALIGN="LEFT"/>dot/20 can incorrectly receive the existing<BR ALIGN="LEFT"/>dot/12 style. The key does not include all<BR ALIGN="LEFT"/>intrinsic state.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch11/main.cpp:56-61<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch11/main.cpp:62-67<BR ALIGN="LEFT"/>    Mark left(first, 3);<BR ALIGN="LEFT"/>    Mark right(same, 8);<BR ALIGN="LEFT"/>    check(left.draw() == &quot;dot/12@3&quot;);<BR ALIGN="LEFT"/>    check(right.draw() == &quot;dot/12@8&quot;);<BR ALIGN="LEFT"/>    Mark copied(std::move(left));<BR ALIGN="LEFT"/>    check(copied.draw() == left.draw());</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>A map interns immutable Style objects by a<BR ALIGN="LEFT"/>complete structured key. shared_ptr allows<BR ALIGN="LEFT"/>marks to retain styles after a pool is<BR ALIGN="LEFT"/>destroyed.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Published Style objects are immutable.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Place x inside the shared Style and mutate<BR ALIGN="LEFT"/>it for each mark. Moving or constructing one<BR ALIGN="LEFT"/>mark changes the apparent position of other<BR ALIGN="LEFT"/>marks. Per-use state was incorrectly shared.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch11/main.cpp:62-67<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch11/main.cpp:68-73<BR ALIGN="LEFT"/>    check(pool.get(&quot;dot&quot;, 1)-&gt;size == 1);<BR ALIGN="LEFT"/>    check(pool.get(&quot;dot&quot;, 100)-&gt;size == 100);<BR ALIGN="LEFT"/>    bool rejected = false;<BR ALIGN="LEFT"/>    try { static_cast&lt;void&gt;(pool.get(&quot;dot&quot;, 0)); }<BR ALIGN="LEFT"/>    catch (const std::invalid_argument&amp;) { rejected = true; }<BR ALIGN="LEFT"/>    check(rejected);</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>A map interns immutable Style objects by a<BR ALIGN="LEFT"/>complete structured key. shared_ptr allows<BR ALIGN="LEFT"/>marks to retain styles after a pool is<BR ALIGN="LEFT"/>destroyed.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Each Mark owns its own position and shares<BR ALIGN="LEFT"/>only intrinsic style state.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Return a raw pointer to a pool-owned object,<BR ALIGN="LEFT"/>then destroy the pool. A later Mark draw may<BR ALIGN="LEFT"/>dereference a destroyed Style. A raw borrow<BR ALIGN="LEFT"/>does not preserve shared lifetime.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch11/main.cpp:68-73<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}