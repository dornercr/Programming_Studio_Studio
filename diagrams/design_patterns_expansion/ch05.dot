digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch05/main.cpp:32-37<BR ALIGN="LEFT"/>    auto&amp; first = TicketDispenser::instance();<BR ALIGN="LEFT"/>    auto&amp; second = TicketDispenser::instance();<BR ALIGN="LEFT"/>    check(&amp;first == &amp;second);<BR ALIGN="LEFT"/>    const int a = first.take();<BR ALIGN="LEFT"/>    const int b = second.take();<BR ALIGN="LEFT"/>    const int c = first.take();</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>A private constructor, deleted copying, and<BR ALIGN="LEFT"/>a local static instance control access and<BR ALIGN="LEFT"/>lifetime. A separate lock_guard protects<BR ALIGN="LEFT"/>mutable state during take. A reference lends<BR ALIGN="LEFT"/>the service without transferring ownership.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Successful requests return distinct integers<BR ALIGN="LEFT"/>from 1 through 3.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Assume local static initialization also<BR ALIGN="LEFT"/>synchronizes next_++. Concurrent calls<BR ALIGN="LEFT"/>without a method lock create a data race and<BR ALIGN="LEFT"/>undefined behavior. The once-only<BR ALIGN="LEFT"/>initialization guard protects construction,<BR ALIGN="LEFT"/>not later member accesses.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch05/main.cpp:32-37<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch05/main.cpp:38-43<BR ALIGN="LEFT"/>    check(a == 1 &amp;&amp; b == 2 &amp;&amp; c == 3);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;same instance=yes\n&quot;;<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;tickets=&quot; &lt;&lt; a &lt;&lt; ',' &lt;&lt; b &lt;&lt; ',' &lt;&lt; c &lt;&lt; '\n';<BR ALIGN="LEFT"/>    bool rejected = false;<BR ALIGN="LEFT"/>    try { second.take(); }<BR ALIGN="LEFT"/>    catch (const std::out_of_range&amp;) { rejected = true; }</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>A private constructor, deleted copying, and<BR ALIGN="LEFT"/>a local static instance control access and<BR ALIGN="LEFT"/>lifetime. A separate lock_guard protects<BR ALIGN="LEFT"/>mutable state during take. A reference lends<BR ALIGN="LEFT"/>the service without transferring ownership.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>next_ remains 4 after exhaustion; rejection<BR ALIGN="LEFT"/>does not consume more state.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Check the limit under a lock, unlock, then<BR ALIGN="LEFT"/>increment later. Two callers can both pass<BR ALIGN="LEFT"/>the same availability check before either<BR ALIGN="LEFT"/>reserves a ticket. The check and state<BR ALIGN="LEFT"/>change no longer form one protected<BR ALIGN="LEFT"/>operation.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch05/main.cpp:38-43<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch05/main.cpp:44-49<BR ALIGN="LEFT"/>    check(rejected);<BR ALIGN="LEFT"/>    rejected = false;<BR ALIGN="LEFT"/>    try { first.take(); }<BR ALIGN="LEFT"/>    catch (const std::out_of_range&amp;) { rejected = true; }<BR ALIGN="LEFT"/>    check(rejected);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;exhausted remains exhausted\n&quot;;</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>A private constructor, deleted copying, and<BR ALIGN="LEFT"/>a local static instance control access and<BR ALIGN="LEFT"/>lifetime. A separate lock_guard protects<BR ALIGN="LEFT"/>mutable state during take. A reference lends<BR ALIGN="LEFT"/>the service without transferring ownership.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Every mutable counter access in take occurs<BR ALIGN="LEFT"/>while gate_ is locked.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Assume local static initialization also<BR ALIGN="LEFT"/>synchronizes next_++. Concurrent calls<BR ALIGN="LEFT"/>without a method lock create a data race and<BR ALIGN="LEFT"/>undefined behavior. The once-only<BR ALIGN="LEFT"/>initialization guard protects construction,<BR ALIGN="LEFT"/>not later member accesses.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch05/main.cpp:44-49<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}