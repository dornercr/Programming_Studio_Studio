digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch09/main.cpp:63-68<BR ALIGN="LEFT"/>    auto first = std::make_unique&lt;Prefix&gt;(<BR ALIGN="LEFT"/>        std::make_unique&lt;Limit&gt;(std::make_unique&lt;Plain&gt;(&quot;ready now&quot;), 5),<BR ALIGN="LEFT"/>        &quot;WARN &quot;);<BR ALIGN="LEFT"/>    auto second = std::make_unique&lt;Limit&gt;(<BR ALIGN="LEFT"/>        std::make_unique&lt;Prefix&gt;(std::make_unique&lt;Plain&gt;(&quot;ready now&quot;),<BR ALIGN="LEFT"/>                                 &quot;WARN &quot;), 5);</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each wrapper owns exactly one Message and<BR ALIGN="LEFT"/>implements the same query. Ownership makes<BR ALIGN="LEFT"/>the assembled chain self-contained; explicit<BR ALIGN="LEFT"/>nesting makes order reviewable.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Every wrapper has one non-null inner owner.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Assume Prefix(Limit(text)) and<BR ALIGN="LEFT"/>Limit(Prefix(text)) are equivalent. The<BR ALIGN="LEFT"/>first produces WARN ready, the second WARN<BR ALIGN="LEFT"/>plus a trailing space. The limit acts on<BR ALIGN="LEFT"/>different intermediate strings.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch09/main.cpp:63-68<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch09/main.cpp:69-74<BR ALIGN="LEFT"/>    check(first-&gt;text() == &quot;WARN ready&quot;);<BR ALIGN="LEFT"/>    check(second-&gt;text() == &quot;WARN &quot;);<BR ALIGN="LEFT"/>    check(Plain(&quot;&quot;).text().empty());<BR ALIGN="LEFT"/>    Limit zero(std::make_unique&lt;Plain&gt;(&quot;ready&quot;), 0);<BR ALIGN="LEFT"/>    check(zero.text().empty());<BR ALIGN="LEFT"/>    Limit wide(std::make_unique&lt;Plain&gt;(&quot;ready&quot;), 99);</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each wrapper owns exactly one Message and<BR ALIGN="LEFT"/>implements the same query. Ownership makes<BR ALIGN="LEFT"/>the assembled chain self-contained; explicit<BR ALIGN="LEFT"/>nesting makes order reviewable.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>text returns a new value and does not mutate<BR ALIGN="LEFT"/>the chain.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Return const std::string&amp; to a local result<BR ALIGN="LEFT"/>variable. The caller receives a dangling<BR ALIGN="LEFT"/>reference after the method returns. A local<BR ALIGN="LEFT"/>string is destroyed at the end of its scope.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch09/main.cpp:69-74<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch09/main.cpp:75-80<BR ALIGN="LEFT"/>    check(wide.text() == &quot;ready&quot;);<BR ALIGN="LEFT"/>    bool rejected = false;<BR ALIGN="LEFT"/>    try { Prefix bad(nullptr, &quot;WARN &quot;); }<BR ALIGN="LEFT"/>    catch (const std::invalid_argument&amp;) { rejected = true; }<BR ALIGN="LEFT"/>    check(rejected);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;prefix outside: '&quot; &lt;&lt; first-&gt;text() &lt;&lt; &quot;'\n&quot;;</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each wrapper owns exactly one Message and<BR ALIGN="LEFT"/>implements the same query. Ownership makes<BR ALIGN="LEFT"/>the assembled chain self-contained; explicit<BR ALIGN="LEFT"/>nesting makes order reviewable.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Limit applies to the complete result<BR ALIGN="LEFT"/>returned by its immediate inner object.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Allow inner_ to be null. Calling text<BR ALIGN="LEFT"/>dereferences a null pointer and has<BR ALIGN="LEFT"/>undefined behavior. The wrapper has no<BR ALIGN="LEFT"/>component to delegate to.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch09/main.cpp:75-80<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}