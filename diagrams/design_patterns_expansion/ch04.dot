digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch04/main.cpp:62-67<BR ALIGN="LEFT"/>    std::vector&lt;std::unique_ptr&lt;Cue&gt;&gt; originals;<BR ALIGN="LEFT"/>    originals.push_back(std::make_unique&lt;TextCue&gt;(&quot;Start&quot;));<BR ALIGN="LEFT"/>    originals.push_back(std::make_unique&lt;ListCue&gt;(<BR ALIGN="LEFT"/>        std::vector&lt;std::string&gt;{&quot;Check&quot;, &quot;Begin&quot;}));<BR ALIGN="LEFT"/>    std::vector&lt;std::unique_ptr&lt;Cue&gt;&gt; copies;<BR ALIGN="LEFT"/>    // No concrete type is named here.</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each concrete cue implements clone with its<BR ALIGN="LEFT"/>own copy constructor. Value-owned strings<BR ALIGN="LEFT"/>and vectors give independent editable state,<BR ALIGN="LEFT"/>while unique_ptr states ownership of each<BR ALIGN="LEFT"/>new polymorphic object.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>clone returns a new owner of the same<BR ALIGN="LEFT"/>concrete kind and equivalent initial value.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Construct a new owning handle from the<BR ALIGN="LEFT"/>original raw pointer. Both owners refer to<BR ALIGN="LEFT"/>one object; destruction attempts to delete<BR ALIGN="LEFT"/>it twice. An owning-handle copy is not an<BR ALIGN="LEFT"/>object clone.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch04/main.cpp:62-67<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch04/main.cpp:68-73<BR ALIGN="LEFT"/>    for (const auto&amp; cue : originals) {<BR ALIGN="LEFT"/>        copies.push_back(cue-&gt;clone());<BR ALIGN="LEFT"/>        check(copies.back()-&gt;text() ==<BR ALIGN="LEFT"/>              cue-&gt;text());<BR ALIGN="LEFT"/>    }<BR ALIGN="LEFT"/>    copies[1]-&gt;rename(&quot;Inspect&quot;);</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each concrete cue implements clone with its<BR ALIGN="LEFT"/>own copy constructor. Value-owned strings<BR ALIGN="LEFT"/>and vectors give independent editable state,<BR ALIGN="LEFT"/>while unique_ptr states ownership of each<BR ALIGN="LEFT"/>new polymorphic object.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>A successful rename preserves nonempty<BR ALIGN="LEFT"/>names.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Use shared_ptr&lt;string&gt; for editable clone<BR ALIGN="LEFT"/>state without copying the string. Renaming<BR ALIGN="LEFT"/>the clone also changes the original’s<BR ALIGN="LEFT"/>visible name. Copying the shared handle<BR ALIGN="LEFT"/>preserves shared identity rather than<BR ALIGN="LEFT"/>independent value.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch04/main.cpp:68-73<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch04/main.cpp:74-79<BR ALIGN="LEFT"/>    check(originals[1]-&gt;text() == &quot;list:Check;Begin;&quot;);<BR ALIGN="LEFT"/>    check(copies[1]-&gt;text() == &quot;list:Inspect;Begin;&quot;);<BR ALIGN="LEFT"/>    check(copies[0].get() != originals[0].get());<BR ALIGN="LEFT"/>    std::cout &lt;&lt; originals[1]-&gt;text() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    std::cout &lt;&lt; copies[1]-&gt;text() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    bool rejected = false;</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each concrete cue implements clone with its<BR ALIGN="LEFT"/>own copy constructor. Value-owned strings<BR ALIGN="LEFT"/>and vectors give independent editable state,<BR ALIGN="LEFT"/>while unique_ptr states ownership of each<BR ALIGN="LEFT"/>new polymorphic object.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Cloned editable contents do not alias<BR ALIGN="LEFT"/>originals.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Construct a new owning handle from the<BR ALIGN="LEFT"/>original raw pointer. Both owners refer to<BR ALIGN="LEFT"/>one object; destruction attempts to delete<BR ALIGN="LEFT"/>it twice. An owning-handle copy is not an<BR ALIGN="LEFT"/>object clone.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch04/main.cpp:74-79<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}