digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch12/main.cpp:61-66<BR ALIGN="LEFT"/>    Source source;<BR ALIGN="LEFT"/>    HoursProxy proxy(source);<BR ALIGN="LEFT"/>    check(!proxy.loaded() &amp;&amp; source.reads == 0);<BR ALIGN="LEFT"/>    check(proxy.opening() == 8);<BR ALIGN="LEFT"/>    check(proxy.loaded() &amp;&amp; source.reads == 1);<BR ALIGN="LEFT"/>    source.hour = 9;</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>One proxy keeps permission, lazy ownership,<BR ALIGN="LEFT"/>and cache state beside the service access<BR ALIGN="LEFT"/>they control. optional distinguishes no<BR ALIGN="LEFT"/>result from a valid zero result.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Denied reads never reach the service or<BR ALIGN="LEFT"/>return cached data.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Use if (*cached_) to decide whether the<BR ALIGN="LEFT"/>cache contains data. Dereferencing an empty<BR ALIGN="LEFT"/>optional is invalid; zero is also<BR ALIGN="LEFT"/>incorrectly treated as a miss. Value<BR ALIGN="LEFT"/>presence and numeric truth are different<BR ALIGN="LEFT"/>questions.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch12/main.cpp:61-66<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch12/main.cpp:67-72<BR ALIGN="LEFT"/>    check(proxy.opening() == 8 &amp;&amp; source.reads == 1);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;cached=&quot; &lt;&lt; proxy.opening() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    proxy.invalidate();<BR ALIGN="LEFT"/>    check(proxy.opening() == 9 &amp;&amp; source.reads == 2);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; &quot;fresh=&quot; &lt;&lt; proxy.opening() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    proxy.allow(false);</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>One proxy keeps permission, lazy ownership,<BR ALIGN="LEFT"/>and cache state beside the service access<BR ALIGN="LEFT"/>they control. optional distinguishes no<BR ALIGN="LEFT"/>result from a valid zero result.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>An engaged cache contains a successful prior<BR ALIGN="LEFT"/>result.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Return cached data before checking allowed_.<BR ALIGN="LEFT"/>After revocation the caller still receives<BR ALIGN="LEFT"/>nine from the warm cache. The fast path<BR ALIGN="LEFT"/>bypasses the permission rule.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch12/main.cpp:67-72<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch12/main.cpp:73-78<BR ALIGN="LEFT"/>    bool denied = false;<BR ALIGN="LEFT"/>    try { static_cast&lt;void&gt;(proxy.opening()); }<BR ALIGN="LEFT"/>    catch (const std::runtime_error&amp;) { denied = true; }<BR ALIGN="LEFT"/>    check(denied &amp;&amp; source.reads == 2);<BR ALIGN="LEFT"/>    proxy.allow(true);<BR ALIGN="LEFT"/>    source.hour = 0;</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>One proxy keeps permission, lazy ownership,<BR ALIGN="LEFT"/>and cache state beside the service access<BR ALIGN="LEFT"/>they control. optional distinguishes no<BR ALIGN="LEFT"/>result from a valid zero result.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Invalidation removes the result but does not<BR ALIGN="LEFT"/>destroy the service.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Assume changing source.hour refreshes the<BR ALIGN="LEFT"/>proxy automatically. After changing eight to<BR ALIGN="LEFT"/>nine, the next call returns eight. No<BR ALIGN="LEFT"/>observer or revision check connects the<BR ALIGN="LEFT"/>source change to cache invalidation.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch12/main.cpp:73-78<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
s1->s2 [arrowhead=vee,penwidth=2,label="continue in source order"];
}