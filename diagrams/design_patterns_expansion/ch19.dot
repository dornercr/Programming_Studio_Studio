digraph G { graph [rankdir=TB, bgcolor="#fbfcff", pad="0.25", nodesep="0.45", ranksep="0.5"]; node [shape=plain]; edge [fontname="Arial", fontsize=13,color="#52649b"];
s0 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Enter the demonstration</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch19/main.cpp:69-74<BR ALIGN="LEFT"/>    Session session;<BR ALIGN="LEFT"/>    check(session.name() == &quot;idle&quot;);<BR ALIGN="LEFT"/>    check(!session.send(Event::finish));<BR ALIGN="LEFT"/>    check(!session.send(Event::reset));<BR ALIGN="LEFT"/>    std::cout &lt;&lt; session.name() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    check(session.send(Event::begin));</FONT></TD></TR></TABLE>>];
note0 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Enter the demonstration in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each state returns a proposed next state.<BR ALIGN="LEFT"/>Session owns the current state and commits<BR ALIGN="LEFT"/>the replacement after the call completes.<BR ALIGN="LEFT"/>Returning no pointer is an ordinary rejected<BR ALIGN="LEFT"/>event.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Session owns exactly one live state during<BR ALIGN="LEFT"/>public calls.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Destroy the current state inside its<BR ALIGN="LEFT"/>still-running next method. A later member<BR ALIGN="LEFT"/>access in that method can access a destroyed<BR ALIGN="LEFT"/>object. Replacing ownership can end the<BR ALIGN="LEFT"/>lifetime of the object whose method is<BR ALIGN="LEFT"/>active.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch19/main.cpp:69-74<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s0;note0;}
s0->note0 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s1 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Follow the next operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch19/main.cpp:75-80<BR ALIGN="LEFT"/>    check(session.name() == &quot;active&quot;);<BR ALIGN="LEFT"/>    check(!session.send(Event::begin));<BR ALIGN="LEFT"/>    check(!session.send(Event::reset));<BR ALIGN="LEFT"/>    std::cout &lt;&lt; session.name() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    check(session.send(Event::finish));<BR ALIGN="LEFT"/>    check(session.name() == &quot;done&quot;);</FONT></TD></TR></TABLE>>];
note1 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Follow the next operations in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each state returns a proposed next state.<BR ALIGN="LEFT"/>Session owns the current state and commits<BR ALIGN="LEFT"/>the replacement after the call completes.<BR ALIGN="LEFT"/>Returning no pointer is an ordinary rejected<BR ALIGN="LEFT"/>event.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>Rejected events preserve the current state.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Treat every reset event as a transition to<BR ALIGN="LEFT"/>idle. reset becomes accepted while active,<BR ALIGN="LEFT"/>bypassing the defined finish path. Events<BR ALIGN="LEFT"/>mean different things in different states; a<BR ALIGN="LEFT"/>global shortcut changes the protocol.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch19/main.cpp:75-80<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s1;note1;}
s1->note1 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s2 [label=<<TABLE BORDER="1" COLOR="#91a4cf" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD BGCOLOR="#e6edff"><FONT FACE="Arial" POINT-SIZE="16"><B>Observe checks and effects</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffffff"><FONT FACE="Courier" POINT-SIZE="13">// companion/examples/ch19/main.cpp:81-86<BR ALIGN="LEFT"/>    check(!session.send(Event::begin));<BR ALIGN="LEFT"/>    check(!session.send(Event::finish));<BR ALIGN="LEFT"/>    std::cout &lt;&lt; session.name() &lt;&lt; '\n';<BR ALIGN="LEFT"/>    check(session.send(Event::reset));<BR ALIGN="LEFT"/>    check(session.name() == &quot;idle&quot;);<BR ALIGN="LEFT"/>    std::cout &lt;&lt; session.name() &lt;&lt; '\n';</FONT></TD></TR></TABLE>>];
note2 [label=<<TABLE BORDER="1" COLOR="#c9b789" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="#fffaf0" WIDTH="510"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT THIS BLOCK MEANS</B><BR ALIGN="LEFT"/>Observe checks and effects in the actual<BR ALIGN="LEFT"/>demonstration, using the original program.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHERE IT FITS</B><BR ALIGN="LEFT"/>main runs after the type and function<BR ALIGN="LEFT"/>definitions; these are consecutive source<BR ALIGN="LEFT"/>excerpts.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHY IT IS HERE</B><BR ALIGN="LEFT"/>Each state returns a proposed next state.<BR ALIGN="LEFT"/>Session owns the current state and commits<BR ALIGN="LEFT"/>the replacement after the call completes.<BR ALIGN="LEFT"/>Returning no pointer is an ordinary rejected<BR ALIGN="LEFT"/>event.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT MUST STAY TRUE</B><BR ALIGN="LEFT"/>A state handler cannot destroy its own<BR ALIGN="LEFT"/>receiver through Session.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>WHAT CAN GO WRONG</B><BR ALIGN="LEFT"/>Destroy the current state inside its<BR ALIGN="LEFT"/>still-running next method. A later member<BR ALIGN="LEFT"/>access in that method can access a destroyed<BR ALIGN="LEFT"/>object. Replacing ownership can end the<BR ALIGN="LEFT"/>lifetime of the object whose method is<BR ALIGN="LEFT"/>active.<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" POINT-SIZE="14"><B>FIND THE CODE</B><BR ALIGN="LEFT"/>companion/examples/ch19/main.cpp:81-86<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same;s2;note2;}
s2->note2 [style=dashed,arrowhead=none,color="#b5985b",label="teaching annotation"];
s0->s1 [arrowhead=vee,penwidth=2,label="continue in source order"];
