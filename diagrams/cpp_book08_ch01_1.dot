digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"count" [label=<<TABLE BORDER="1" WIDTH="196" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="196" BGCOLOR="#eee9fb"><B>Service model state</B></TD></TR><TR><TD WIDTH="196" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">unsigned queued=0;<BR ALIGN="LEFT"/>// queued is 0, 1, or 2.</FONT></TD></TR></TABLE>>];
"invalid" [label=<<TABLE BORDER="1" WIDTH="336" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="336" BGCOLOR="#eee9fb"><B>Invalid input branch</B></TD></TR><TR><TD WIDTH="336" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if(n&lt;0||n&gt;100)return Outcome::invalid;<BR ALIGN="LEFT"/>// No state change; caller should fix input.</FONT></TD></TR></TABLE>>];
"busy" [label=<<TABLE BORDER="1" WIDTH="322" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="322" BGCOLOR="#eee9fb"><B>Saturated branch</B></TD></TR><TR><TD WIDTH="322" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if(queued==2)return Outcome::busy;<BR ALIGN="LEFT"/>// No state change; capacity is exhausted.</FONT></TD></TR></TABLE>>];
"accepted" [label=<<TABLE BORDER="1" WIDTH="266" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="266" BGCOLOR="#eee9fb"><B>Accepted transition</B></TD></TR><TR><TD WIDTH="266" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">++queued;<BR ALIGN="LEFT"/>return Outcome::accepted;<BR ALIGN="LEFT"/>// State changes 0 to 1 or 1 to 2.</FONT></TD></TR></TABLE>>];
"count" -> "invalid" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="130" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="130">check input first</TD></TR></TABLE>>];
"invalid" -> "busy" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="137" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="137">continue only when<BR/>input is valid</TD></TR></TABLE>>];
"busy" -> "accepted" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="137" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="137">continue only when<BR/>queued &lt; 2</TD></TR></TABLE>>];
"accepted" -> "count" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="157" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="157">next request observes<BR/>new count</TD></TR></TABLE>>];
}