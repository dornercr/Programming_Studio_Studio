digraph G { graph [rankdir=TB, bgcolor="#fcfcff", pad="0.25", nodesep="0.55", ranksep="0.85", splines=polyline]; node [shape=plain, fontname="Helvetica", fontsize=14]; edge [fontname="Helvetica", fontsize=11, color="#7355df", fontcolor="#514675", penwidth=1.6];
"F" [label=<<TABLE BORDER="1" WIDTH="196" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="196" BGCOLOR="#eee9fb"><B>Publisher: Feed</B></TD></TR><TR><TD WIDTH="196" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">Reset reset{notifying_};</FONT></TD></TR></TABLE>>];
"W" [label=<<TABLE BORDER="1" WIDTH="238" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="238" BGCOLOR="#eee9fb"><B>Registration</B></TD></TR><TR><TD WIDTH="238" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">if (auto live = weak.lock()) {</FONT></TD></TR></TABLE>>];
"L" [label=<<TABLE BORDER="1" WIDTH="190" COLOR="#bdb1da" BGCOLOR="#ffffff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD WIDTH="190" BGCOLOR="#eee9fb"><B>Observer: Total</B></TD></TR><TR><TD WIDTH="190" ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">live-&gt;update(value);</FONT></TD></TR></TABLE>>];
"F" -> "W" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">try to acquire<BR/>temporary ownership</TD></TR></TABLE>>];
"W" -> "L" [arrowhead=vee,label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="144" CELLSPACING="0" CELLPADDING="5"><TR><TD WIDTH="144">only if listener is<BR/>still alive</TD></TR></TABLE>>];
}