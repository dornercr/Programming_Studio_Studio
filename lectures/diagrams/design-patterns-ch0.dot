digraph IntroEstimate {
  graph [rankdir=TB, bgcolor="#0b1424", pad="0.30", nodesep="0.6", ranksep="0.65", splines=polyline, outputorder=edgesfirst];
  node [shape=plain];
  edge [color="#d7e2f1", penwidth=1.8, arrowsize=1.25, fontname="DejaVu Sans", fontsize=14, fontcolor="#d7e2f1"];
owner [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="730" BGCOLOR="#132338"><TR><TD BGCOLOR="#553987" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="16" COLOR="#ffffff"><B>OWNERSHIP VIEW · main / local variable rule</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#92d5c3">//&#160;Teaching:&#160;unique_ptr&#160;owns;&#160;replacement&#160;destroys&#160;the&#160;old&#160;object.</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">int&#160;main()&#160;{</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">&#160;&#160;&#160;&#160;std::unique_ptr&lt;Estimate&gt;&#160;rule&#160;=&#160;std::make_unique&lt;Mean&gt;();</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">&#160;&#160;&#160;&#160;std::cout&#160;&lt;&lt;&#160;&quot;mean=&quot;&#160;&lt;&lt;&#160;rule-&gt;value(1,&#160;9)&#160;&lt;&lt;&#160;&#x27;\n&#x27;;</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">&#160;&#160;&#160;&#160;rule&#160;=&#160;std::make_unique&lt;Highest&gt;();&#160;//&#160;Replace&#160;the&#160;owned&#160;rule.</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">&#160;&#160;&#160;&#160;std::cout&#160;&lt;&lt;&#160;&quot;highest=&quot;&#160;&lt;&lt;&#160;rule-&gt;value(1,&#160;9)&#160;&lt;&lt;&#160;&#x27;\n&#x27;;</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">}</FONT></TD></TR></TABLE>>];
base [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="730" BGCOLOR="#132338"><TR><TD BGCOLOR="#12616a" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="16" COLOR="#ffffff"><B>CLASS · Estimate — common contract</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#92d5c3">//&#160;Teaching:&#160;virtual&#160;chooses&#160;an&#160;override&#160;through&#160;a&#160;base&#160;pointer.</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">class&#160;Estimate&#160;{</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">public:</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">&#160;&#160;&#160;&#160;virtual&#160;~Estimate()&#160;=&#160;default;</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">&#160;&#160;&#160;&#160;//&#160;Contract:&#160;a&#160;and&#160;b&#160;are&#160;both&#160;in&#160;[0,&#160;1000].</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">&#160;&#160;&#160;&#160;virtual&#160;int&#160;value(int&#160;a,&#160;int&#160;b)&#160;const&#160;=&#160;0;</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">};</FONT></TD></TR></TABLE>>];
mean [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="730" BGCOLOR="#132338"><TR><TD BGCOLOR="#274b70" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="16" COLOR="#ffffff"><B>CLASS · Mean — first concrete rule</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#92d5c3">//&#160;Teaching:&#160;override&#160;asks&#160;the&#160;compiler&#160;to&#160;check&#160;the&#160;base&#160;match.</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">class&#160;Mean&#160;final&#160;:&#160;public&#160;Estimate&#160;{</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">public:</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">&#160;&#160;&#160;&#160;int&#160;value(int&#160;a,&#160;int&#160;b)&#160;const&#160;override&#160;{&#160;return&#160;(a&#160;+&#160;b)&#160;/&#160;2;&#160;}</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">};</FONT></TD></TR></TABLE>>];
highest [label=<<TABLE BORDER="1" COLOR="#475569" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" WIDTH="730" BGCOLOR="#132338"><TR><TD BGCOLOR="#274b70" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="16" COLOR="#ffffff"><B>CLASS · Highest — replacement concrete rule</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#92d5c3">//&#160;Teaching:&#160;the&#160;same&#160;value&#160;call&#160;now&#160;chooses&#160;the&#160;highest&#160;input.</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">class&#160;Highest&#160;final&#160;:&#160;public&#160;Estimate&#160;{</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">public:</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">&#160;&#160;&#160;&#160;int&#160;value(int&#160;a,&#160;int&#160;b)&#160;const&#160;override&#160;{&#160;return&#160;std::max(a,&#160;b);&#160;}</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="730"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14" COLOR="#e5ecf5">};</FONT></TD></TR></TABLE>>];

  owner:s -> base:n [dir=both, arrowtail=diamond, arrowhead=none, label="owns one current concrete object"];
  base -> mean [style=invis, weight=10];
  mean -> highest [style=invis, weight=10];
  mean:w -> base:w [constraint=false, arrowhead=empty, label="public inheritance"];
  highest:e -> base:e [constraint=false, arrowhead=empty, label="public inheritance"];
}
