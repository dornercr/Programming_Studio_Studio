:3,"partTitle":"Kernel and virtual memory"},{"number":27,"title":"Memory Hierarchy","part":4,"partTitle":"Memory hierarchy and caches"},{"number":28,"title":"Locality","part":4,"partTitle":"Memory hierarchy and caches"},{"number":29,"title":"Cache Organization","part":4,"partTitle":"Memory hierarchy and caches"},{"number":30,"title":"Cache Behavior","part":4,"partTitle":"Memory hierarchy and caches"},{"number":31,"title":"Cache Replacement","part":4,"partTitle":"Memory hierarchy and caches"},{"number":32,"title":"Cache Performance","part":4,"partTitle":"Memory hierarchy and caches"},{"number":33,"title":"Files","part":5,"partTitle":"Files and processes"},{"number":34,"title":"File Descriptors","part":5,"partTitle":"Files and processes"},{"number":35,"title":"Buffered I/O","part":5,"partTitle":"Files and processes"},{"number":36,"title":"Memory-Mapped Files","part":5,"partTitle":"Files and processes"},{"number":37,"title":"Process Creation","part":5,"partTitle":"Files and processes"},{"number":38,"title":"Program Execution","part":5,"partTitle":"Files and processes"},{"number":39,"title":"Process Termination","part":5,"partTitle":"Files and processes"},{"number":40,"title":"Pipes and Redirection","part":5,"partTitle":"Files and processes"},{"number":41,"title":"Signals","part":5,"partTitle":"Files and processes"},{"number":42,"title":"Shell Architecture","part":5,"partTitle":"Files and processes"},{"number":43,"title":"Concurrent Execution","part":6,"partTitle":"Threads and synchronization"},{"number":44,"title":"Threads","part":6,"partTitle":"Threads and synchronization"},{"number":45,"title":"Race Conditions","part":6,"partTitle":"Threads and synchronization"},{"number":46,"title":"Atomic Operations","part":6,"partTitle":"Threads and synchronization"},{"number":47,"title":"Mutual Exclusion","part":6,"partTitle":"Threads and synchronization"},{"number":48,"title":"Condition Variables","part":6,"partTitle":"Threads and synchronization"},{"number":49,"title":"Producer–Consumer Systems","part":6,"partTitle":"Threads and synchronization"},{"number":50,"title":"Deadlock","part":6,"partTitle":"Threads and synchronization"},{"number":51,"title":"Network Programming","part":7,"partTitle":"Networks and servers"},{"number":52,"title":"Concurrent Servers","part":7,"partTitle":"Networks and servers"},{"number":53,"title":"Event-Driven I/O","part":7,"partTitle":"Networks and servers"},{"number":54,"title":"Measuring Performance","part":8,"partTitle":"Measurement and optimization"},{"number":55,"title":"Program Optimization","part":8,"partTitle":"Measurement and optimization"},{"number":56,"title":"Performance Analysis","part":8,"partTitle":"Measurement and optimization"},{"number":57,"title":"Memory-Safety Vulnerabilities","part":9,"partTitle":"Security and robustness"},{"number":58,"title":"Exploit Mitigations","part":9,"partTitle":"Security and robustness"},{"number":59,"title":"System Robustness","part":9,"partTitle":"Security and robustness"},{"number":60,"title":"From Source Code to Running Program","part":10,"partTitle":"Whole-system integration"},{"number":61,"title":"Putting the System Together","part":10,"partTitle":"Whole-system integration"}],"glossary":[{"id":"SYS01-g1","chapter":1,"term":"Contract","definition":"The inputs, results, and rules that callers and implementations agree to."},{"id":"SYS01-g2","chapter":1,"term":"Layer","definition":"A part of a system that performs one kind of work through a defined boundary."},{"id":"SYS02-g1","chapter":2,"term":"Value parameter","definition":"A parameter object initialized from the argument; this vector has independent element storage."},{"id":"SYS02-g2","chapter":2,"term":"Reference parameter","definition":"Another name for the caller’s object, with no new copy of that object."},{"id":"SYS03-g1","chapter":3,"term":"Mask","definition":"A bit pattern selecting which bit positions an operation should affect."},{"id":"SYS03-g2","chapter":3,"term":"Bit field","definition":"A fixed group of bits used to store one value within a larger word."},{"id":"SYS04-g1","chapter":4,"term":"Unsigned wrap","definition":"Unsigned arithmetic reduces a result modulo one more than the type’s maximum value."},{"id":"SYS04-g2","chapter":4,"term":"Precondition","definition":"A rule that must hold before an operation can safely perform its work."},{"id":"SYS05-g1","chapter":5,"term":"Rounding error","definition":"The difference caused when an exact result must be stored as one of the available floating-point values."},{"id":"SYS05-g2","chapter":5,"term":"Relative tolerance","definition":"An allowed error scaled to the magnitude of the compared values."},{"id":"SYS06-g1","chapter":6,"term":"Row-major layout","definition":"Consecutive columns of one row occupy consecutive element positions."},{"id":"SYS06-g2","chapter":6,"term":"Alignment","definition":"A rule about which addresses are valid starting points for an object type."},{"id":"SYS07-g1","chapter":7,"term":"Half-open range","definition":"A range including its first position but excluding its end position."},{"id":"SYS07-g2","chapter":7,"term":"Iterator","definition":"An object representing a position that a traversal can examine and advance."},{"id":"SYS08-g1","chapter":8,"term":"Object lifetime","definition":"The interval during which a constructed object may be used according to its type’s rules."},{"id":"SYS08-g2","chapter":8,"term":"Ownership transfer","definition":"Moving responsibility for releasing a resource from one owner to another."},{"id":"SYS09-g1","chapter":9,"term":"Size","definition":"The number of live elements in a container."},{"id":"SYS09-g2","chapter":9,"term":"Capacity","definition":"The number of elements that fit in currently reserved vector storage without reallocation."},{"id":"SYS10-g1","chapter":10,"term":"Fragmentation","definition":"Space that exists but cannot be used for the desired request under an allocator’s rules."},{"id":"SYS10-g2","chapter":10,"term":"Commit point","definition":"The operation at which a prepared change becomes the visible new state."},{"id":"SYS11-g1","chapter":11,"term":"Bounds error","definition":"An access outside the valid element range of an object."},{"id":"SYS11-g2","chapter":11,"term":"Undefined behavior","definition":"A program operation for which the C++ standard imposes no behavior requirements."},{"id":"SYS12-g1","chapter":12,"term":"Architectural state","definition":"The registers and other state whose behavior an instruction set promises to software."},{"id":"SYS12-g2","chapter":12,"term":"Instruction set","definition":"The operations and rules a machine exposes to programs."},{"id":"SYS13-g1","chapter":13,"term":"Subregister","definition":"A named portion of a larger machine register."},{"id":"SYS13-g2","chapter":13,"term":"Zero extension","definition":"Increasing a value’s width by filling the new high bits with zeros."},{"id":"SYS14-g1","chapter":14,"term":"Effective address","definition":"The address value formed from the components of a machine addressing mode."},{"id":"SYS14-g2","chapter":14,"term":"Displacement","definition":"A fixed offset included in an address calculation."},{"id":"SYS15-g1","chapter":15,"term":"Quotient","definition":"The integer result of division after truncation toward zero in this C++ operation."},{"id":"SYS15-g2","chapter":15,"term":"Remainder","definition":"The part left after multiplying the integer quotient by the divisor."},{"id":"SYS16-g1","chapter":16,"term":"Loop invariant","definition":"A rule maintained before every repetition, used to explain the loop’s result."},{"id":"SYS16-g2","chapter":16,"term":"Control flow","definition":"The order in which a program can execute its operations."},{"id":"SYS17-g1","chapter":17,"term":"ABI","definition":"The binary-level agreement for calls, object layout, symbols, and other machine interfaces."},{"id":"SYS17-g2","chapter":17,"term":"Callee-saved register","definition":"A register whose incoming value a callee must restore when required by the relevant ABI."},{"id":"SYS18-g1","chapter":18,"term":"Aliasing","definition":"Two access paths referring to the same underlying object or storage."},{"id":"SYS18-g2","chapter":18,"term":"Observable behavior","definition":"The effects that a valid optimization must preserve under the language’s rules."},{"id":"SYS19-g1","chapter":19,"term":"Privilege boundary","definition":"A boundary across which code must have different authority to access resources."},{"id":"SYS19-g2","chapter":19,"term":"Validation","definition":"Checking that a request satisfies its required shape, range, and permissions before acting on it."},{"id":"SYS20-g1","chapter":20,"term":"Fault","definition":"An exception associated with an instruction that could not complete under the current conditions."},{"id":"SYS20-g2","chapter":20,"term":"Restart point","definition":"The saved execution position used to retry an operation after a recoverable condition is repaired."},{"id":"SYS21-g1","chapter":21,"term":"Runnable","definition":"Eligible to receive CPU time, though not necessarily executing now."},{"id":"SYS21-g2","chapter":21,"term":"State transition","definition":"A permitted change from one named state to another after an event."},{"id":"SYS22-g1","chapter":22,"term":"Address space","definition":"The mapping context in which a program interprets its virtual addresses."},{"id":"SYS22-g2","chapter":22,"term":"Backing storage","definition":"The underlying storage reached through a mapping or handle."},{"id":"SYS23-g1","chapter":23,"term":"Page","definition":"A fixed-size block in a virtual address space."},{"id":"SYS23-g2","chapter":23,"term":"Frame","definition":"A fixed-size physical-memory block that can back a virtual page."},{"id":"SYS24-g1","chapter":24,"term":"Page-table entry","definition":"A record containing mapping information and access-control state for a page."},{"id":"SYS24-g2","chapter":24,"term":"Protection fault","definition":"An exception caused when an access violates the mapping’s permission rules."},{"id":"SYS25-g1","chapter":25,"term":"TLB","definition":"A cache of recently used virtual-to-physical translations and related access information."},{"id":"SYS25-g2","chapter":25,"term":"Invalidation","definition":"Removing a cached fact when the authoritative state no longer supports it."},{"id":"SYS26-g1","chapter":26,"term":"Copy on write","definition":"Sharing unchanged backing and making a private copy before a permitted private mutation."},{"id":"SYS26-g2","chapter":26,"term":"Demand paging","definition":"Providing backing for a permitted page when an access first requires it."},{"id":"SYS27-g1","chapter":27,"term":"Latency","definition":"The elapsed delay for a particular operation or request."},{"id":"SYS27-g2","chapter":27,"term":"Bandwidth","definition":"The amount of data that can be transferred per unit time under stated conditions."},{"id":"SYS28-g1","chapter":28,"term":"Spatial locality","definition":"Using nearby locations within a short interval."},{"id":"SYS28-g2","chapter":28,"term":"Temporal locality","definition":"Using the same location again before its useful cached state is displaced."},{"id":"SYS29-g1","chapter":29,"term":"Set associativity","definition":"The number of entries in one cache set that can hold competing blocks."},{"id":"SYS29-g2","chapter":29,"term":"Tag","definition":"The part of a block’s identity used to distinguish blocks selecting the same set."},{"id":"SYS30-g1","chapter":30,"term":"Cache hit","definition":"An access whose required block is already present and usable at the modeled cache level."},{"id":"SYS30-g2","chapter":30,"term":"Conflict miss","definition":"A repeated miss caused by restricted placement relative to the chosen fully associative reference model."},{"id":"SYS31-g1","chapter":31,"term":"Replacement policy","definition":"The rule selecting which resident item to remove when space is needed."},{"id":"SYS31-g2","chapter":31,"term":"Dirty line","definition":"A cached block containing changes that must be preserved before the block is discarded."},{"id":"SYS32-g1","chapter":32,"term":"Local miss rate","definition":"Misses divided by requests reaching a particular cache level."},{"id":"SYS32-g2","chapter":32,"term":"AMAT","definition":"Average memory-access time calculated under a stated cost model."},{"id":"SYS33-g1","chapter":33,"term":"File offset","definition":"A byte position used to locate data in a file."},{"id":"SYS33-g2","chapter":33,"term":"Record boundary","definition":"A division between logical items imposed by a format above the byte stream."},{"id":"SYS34-g1","chapter":34,"term":"File descriptor","definition":"A process-local handle used to request operations on an open resource."},{"id":"SYS34-g2","chapter":34,"term":"Short transfer","definition":"A successful operation that moves fewer bytes than requested."},{"id":"SYS35-g1","chapter":35,"term":"Buffering","definition":"Temporarily collecting data so it can be passed onward in useful batches."},{"id":"SYS35-g2","chapter":35,"term":"Flush","definition":"Requesting that buffered data move to the next layer defined by the API."},{"id":"SYS36-g1","chapter":36,"term":"Shared mapping","definition":"A mapping whose writes affect the shared backing according to the mapping API’s rules."},{"id":"SYS36-g2","chapter":36,"term":"Private mapping","definition":"A mapping whose private modifications do not become shared file changes under its contract."},{"id":"SYS37-g1","chapter":37,"term":"Open-file description","definition":"Kernel-maintained state, such as a file offset, that multiple descriptors may reference."},{"id":"SYS37-g2","chapter":37,"term":"Fork","definition":"A process-creation operation that creates a child with defined copies and shared references from its parent."},{"id":"SYS38-g1","chapter":38,"term":"Program image","definition":"The executable code and associated user-space state installed in a process."},{"id":"SYS38-g2","chapter":38,"term":"Exec","definition":"An operation that replaces the calling process’s program image rather than creating a second process."},{"id":"SYS39-g1","chapter":39,"term":"Reaping","definition":"Collecting a terminated child’s status so its retained process record can be released."},{"id":"SYS39-g2","chapter":39,"term":"Exit status","definition":"A result describing how a process terminated; its interpretation depends on the termination category."},{"id":"SYS40-g1","chapter":40,"term":"EOF","definition":"End of stream: no more bytes will be delivered under the stream’s contract."},{"id":"SYS40-g2","chapter":40,"term":"Backpressure","definition":"A limit that makes a producer wait or reduce output when a downstream consumer cannot keep up."},{"id":"SYS41-g1","chapter":41,"term":"Signal","definition":"An asynchronous process notification with delivery and handling rules defined by the OS."},{"id":"SYS41-g2","chapter":41,"term":"Async-signal-safe","definition":"Permitted for use in an asynchronous signal handler under the applicable API’s rules."},{"id":"SYS42-g1","chapter":42,"term":"Token","definition":"A meaningful input unit such as a word or operator produced during parsing."},{"id":"SYS42-g2","chapter":42,"term":"Execution plan","definition":"A validated description of the operations to perform before those operations are started."},{"id":"SYS43-g1","chapter":43,"term":"Interleaving","definition":"One ordering of steps from activities whose lifetimes overlap."},{"id":"SYS43-g2","chapter":43,"term":"Concurrency","definition":"Multiple activities in progress whose steps may be interleaved or run at the same time."},{"id":"SYS44-g1","chapter":44,"term":"Join","definition":"Waiting for a thread’s completion and establishing the completion relationship needed to use its results."},{"id":"SYS44-g2","chapter":44,"term":"Partition","definition":"A division of work into ranges or tasks with explicit coverage and overlap rules."},{"id":"SYS45-g1","chapter":45,"term":"Data race","definition":"Conflicting concurrent C++ accesses, at least one a write, without the required atomicity or happens-before ordering."},{"id":"SYS45-g2","chapter":45,"term":"Logical race","definition":"A result that depends on an undesired ordering of otherwise defined operations."},{"id":"SYS46-g1","chapter":46,"term":"Release/acquire","definition":"A pair of atomic ordering operations that can establish visibility of preceding work when the acquire observes the release."},{"id":"SYS46-g2","chapter":46,"term":"Happens-before","definition":"An ordering relation used by C++ to determine whether effects are properly ordered between evaluations."},{"id":"SYS47-g1","chapter":47,"term":"Critical section","definition":"A region whose operations require coordinated access to shared state."},{"id":"SYS47-g2","chapter":47,"term":"Mutex","definition":"A synchronization object that permits one cooperating owner at a time."},{"id":"SYS48-g1","chapter":48,"term":"Condition variable","definition":"A waiting mechanism used with a mutex and a predicate over shared state."},{"id":"SYS48-g2","chapter":48,"term":"Spurious wakeup","definition":"A return from waiting that does not itself prove the desired condition is true."},{"id":"SYS49-g1","chapter":49,"term":"Drain","definition":"Consume already-accepted work before ending a closed queue or stream."},{"id":"SYS49-g2","chapter":49,"term":"Shutdown protocol","definition":"The rules for stopping new work, waking waiters, finishing or discarding old work, and ending lifetimes."},{"id":"SYS50-g1","chapter":50,"term":"Deadlock","definition":"A state in which participants cannot progress because each waits for conditions the waiting participants must supply."},{"id":"SYS50-g2","chapter":50,"term":"Circular wait","definition":"A cycle of waiting dependencies, such as A waiting for B while B waits for A."},{"id":"SYS51-g1","chapter":51,"term":"Framing","definition":"Rules that identify application message boundaries within a sequence of bytes."},{"id":"SYS51-g2","chapter":51,"term":"Byte stream","definition":"An ordered sequence of bytes without a promise that transfer calls preserve message boundaries."},{"id":"SYS52-g1","chapter":52,"term":"Admission control","definition":"A rule deciding whether new work can enter the system given current resource limits."},{"id":"SYS52-g2","chapter":52,"term":"Overload policy","definition":"The chosen behavior when incoming work exceeds capacity, such as rejection, bounded waiting, or dropping."},{"id":"SYS53-g1","chapter":53,"term":"Readiness","definition":"A notification that an I/O operation may be able to make progress under the API’s conditions."},{"id":"SYS53-g2","chapter":53,"term":"Would-block","definition":"A nonblocking result indicating that immediate progress is unavailable without waiting."},{"id":"SYS54-g1","chapter":54,"term":"Throughput","definition":"Completed work divided by the elapsed measurement interval."},{"id":"SYS54-g2","chapter":54,"term":"Percentile","definition":"A position in an ordered sample or distribution, interpreted using a stated convention."},{"id":"SYS55-g1","chapter":55,"term":"Precomputation","definition":"Doing reusable work once so later operations require less repeated effort."},{"id":"SYS55-g2","chapter":55,"term":"Complexity","definition":"How a program’s required work or storage grows with input size."},{"id":"SYS56-g1","chapter":56,"term":"Amdahl’s law","definition":"A time-based bound on whole-system speedup when only a stated fraction of work changes."},{"id":"SYS56-g2","chapter":56,"term":"Bottleneck","definition":"A resource or phase that limits the performance of the current workload."},{"id":"SYS57-g1","chapter":57,"term":"Trust boundary","definition":"A point where data or actions cross between different levels of trust or authority."},{"id":"SYS57-g2","chapter":57,"term":"Valid extent","definition":"The portion of a buffer that the current operation may treat as meaningful input."},{"id":"SYS58-g1","chapter":58,"term":"Mitigation","definition":"A measure that reduces certain consequences or detects certain failures without necessarily preventing the underlying bug."},{"id":"SYS58-g2","chapter":58,"term":"Defense in depth","definition":"Using protections with different coverage so one failed assumption does not remove every defense."},{"id":"SYS59-g1","chapter":59,"term":"Strong exception guarantee","definition":"A promise that a failed operation leaves the relevant observable state unchanged."},{"id":"SYS59-g2","chapter":59,"term":"Durability","definition":"A guarantee about state surviving the failures specified by a storage protocol, distinct from atomic visibility."},{"id":"SYS60-g1","chapter":60,"term":"Translation unit","definition":"A source unit after preprocessing that the compiler processes under the language’s rules."},{"id":"SYS60-g2","chapter":60,"term":"Linking","definition":"Combining compiled definitions and resolving references to build a program or library."},{"id":"SYS61-g1","chapter":61,"term":"Backpressure boundary","definition":"The point at which bounded downstream capacity makes an upstream producer wait or reject work."},{"id":"SYS61-g2","chapter":61,"term":"End-to-end invariant","definition":"A rule spanning several components, such as every accepted input producing exactly one recorded result."}],"examples":{},"diagrams":{},"lectures":{},"teaching":{},"readingOrder":["SYS01.01","SYS01.02","SP01.001","SP01.002","SP01.003","SYS01.03","SP01.004","SP01.005","SP01.006","SP01.007","SP01.008","SP01.009","SP01.010","SP01.011","SP01.012","SP01.013","SP01.014","SP01.015","SP01.016","SP01.017","SP01.018","SP01.019","SP01.020","SP01.021","SP01.022","SP01.023","SP01.024","SP01.025","SP01.026","SP01.027","SP01.028","SP01.029","SP01.030","SP01.031","SP01.032","SP01.033","SP01.034","SP01.035","SP01.036","SP01.037","SP01.038","SP01.039","SP01.040","SP01.041","SP01.042","SP01.043","SP01.044","SP01.045","SP01.046","SP01.047","SP01.048","SP01.049","SP01.050","SP01.051","SP01.052","SP01